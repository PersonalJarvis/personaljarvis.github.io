#!/bin/sh
# Style gate — docs/layout.md and docs/design.md are contracts, so they are
# checked, not trusted. --no-verify bypasses; doing so without a reason is a defect.
if command -v node >/dev/null 2>&1; then
  node "$(git rev-parse --show-toplevel)/scripts/check-style.mjs" --quiet || exit 1
else
  echo "style gate skipped: node not on PATH" >&2
fi
