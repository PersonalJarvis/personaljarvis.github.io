---
/**
 * Feature section — copy left, CLIs demo right.
 *
 * One of three blocks that share one shape. Everything structural here — the
 * 16/9, the 5/7 split, the missing frame and the missing ground — is
 * deliberately identical to Plugins.astro, and the demo's stage and window come
 * from src/components/window-demo/. Two blocks that are nearly the same read as
 * a mistake; two that are exactly the same read as one product.
 *
 * The three draw no band and no ground of their own: they are one run between
 * the logo strip's closing rule and the voice section's opening one, told apart
 * by a single hairline at each joint. This is the LAST block, so it draws no
 * line of its own — the run's outer boundaries belong to its neighbours, and a
 * rule here as well would be the doubled boundary the shell exists to prevent.
 * That is also why this is the one block of the three still marked `open`.
 * Plugins.astro carries the whole reasoning; change it there, not here.
 *
 * See docs/feature-section.md.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { DOCS_URL } from "@/lib/nav";
import { ClisDemo } from "@/components/clis-demo/ClisDemo";
---

<!--
  No shell, no ground, and no closing rule: the last of the three sections that
  read as one run. `open` because nothing is drawn under this block for the
  square to cross — the voice section below opens on its own pinned frame, an
  inset further down — so the marker hands over on the rail it came down. The
  other two close on `.section-run-rule` and are not `open`. See Plugins.astro
  for the whole reasoning, including why the marker is tracked on the section
  rather than `nested`.
-->
<section id="clis" class="relative flex flex-col">
  <SectionTrack open />
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <!--
      `lg:p-14` and not `lg:px-14`: the block padding is what keeps the well
      beside the copy off the top and bottom of a 16/9 box it would otherwise
      fill whole. See Plugins.astro for why.
    -->
    <div
      class="grid items-center gap-12 px-8 lg:aspect-[16/9] lg:min-h-[560px] lg:grid-cols-12 lg:p-14"
    >
      <div class="lg:col-span-5">
        <!--
          Heading and body are one optical block: same size, separated by
          weight and ink alone.
        -->
        <p class="text-[22px] leading-snug sm:text-[26px]">
          <span class="font-medium text-ink"
            >It drives the command-line tools you already have.</span
          >{" "}
          <span class="text-body"
            >Ask in plain language; it picks the tool, runs the command, and shows
            you exactly what it ran and why that was allowed. Every tool carries
            its own list of commands that are refused before they start.</span
          >
        </p>

        <a
          href={DOCS_URL}
          class="mt-6 inline-flex items-center gap-2 text-[16px] font-medium text-ink underline-offset-4 hover:underline"
        >
          See every command-line tool
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="lg:col-span-7 lg:h-full">
        <ClisDemo client:visible />
      </div>
    </div>
  </Container>
</section>
