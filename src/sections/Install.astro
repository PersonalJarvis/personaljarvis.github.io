---
/**
 * Section 5 — the four steps, and the closing CTA.
 *
 * Two blocks in one file because together they are the end of the page: the
 * steps show that getting in is small and reversible, and the band under them
 * closes it. See docs/section-5-steps-cta.md.
 *
 * THE FOCUS BEHAVIOUR IS THE SIGNATURE. Exactly one step stands at full
 * opacity; the other three sit at .35.
 *
 * THE SECTION HOLDS THE PAGE STILL WHILE IT HAPPENS. A tall track with a
 * sticky child: the frame stops under the reader, each step owns a quarter of
 * the scrolling, and the section lets go once the fourth has had its share
 * (maintainer, 2026-08-29). This file forbade exactly that until then, and the
 * reason it did — sticky variants break on a phone and feel sluggish — is
 * still true, which is why the pin is off below 1280px, below 1020px of window
 * height, and under `prefers-reduced-motion`.
 *
 * The dimming is opt-in, applied by the script through `data-focus` on the
 * list. Without JavaScript, and under `prefers-reduced-motion`, the attribute
 * is never set: every step reads at full opacity, and the section is an
 * ordinary block. That is the accessible resting state, not a degraded one.
 *
 * STEP 1 CARRIES THE INSTALL BOX, AND IT NEVER LEAVES. What used to sit there
 * was a button that was pulled out of the DOM whenever another step took
 * focus. That was affordable for a 44px button; the box that replaced it
 * (maintainer, 2026-08-29 — print the real command, let the visitor pick their
 * machine) is twice that tall, and adding and removing it on every scroll
 * shunted the three steps below it up and down the screen. It dims with the
 * rest of step 1 instead, and hovering step 1 brings it back to full strength
 * — which is also what makes it clickable without scrolling it into focus
 * first.
 *
 * NOTHING HERE IS INVENTED. Every step is provable from README.md ("Install",
 * "Run it") or from jarvis.toml.example; see the comment on each one.
 *
 * Type sizes live in the style block, not in `text-[…]` utilities. A Tailwind
 * arbitrary value holding a bare custom property is ambiguous and resolves as
 * a COLOUR, which silently leaves every heading at body size.
 */
import Container from "@/components/Container.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { TurningMark } from "@/components/mark/TurningMark";
import { REPO } from "@/lib/install";

const steps = [
  {
    title: "One command",
    // README § Install: "One command on Windows, macOS, or Linux. You need
    // Python 3.11 or newer and Git; the installer checks for both and stops
    // with a download link if one is missing." Plus the note under the
    // one-liners: it creates a venv, prefetches the voice models, launches.
    body: "Windows, macOS or Linux, one line. You need Python 3.11 or newer and Git; the installer checks for both and stops with a download link if either is missing. It asks nothing else, builds its own environment, fetches the voice models and opens the app.",
    cta: true,
  },
  {
    title: "Pick a wake word",
    // README § Install: "the app walks you through a one-time setup for
    // language, wake word, and API keys". jarvis.toml.example
    // [trigger.wake_word]: "no wake word ships with the product";
    // [persona]: the name is derived from the phrase you choose.
    body: "The app walks you through language, wake word and keys once. Nothing is preset — you type any phrase you like, and the assistant takes its name from it.",
    cta: false,
  },
  {
    title: "Add a key, or skip it",
    // README § Install, optional table: a provider API key or subscription
    // login (Gemini, Claude, OpenAI, OpenRouter), stored in the credential
    // manager. README § "Runs on your own hardware": every layer has a local
    // option needing no API key and no signup.
    body: "In the same setup you hand over a provider key or a subscription login — Gemini, Claude, OpenAI or OpenRouter. It goes into your operating system's credential manager, never into a file. Every tier also has a local option that needs no key at all, so this step is skippable.",
    cta: false,
  },
  {
    title: "Say it",
    // README § Run it: `jarvis` is the full desktop with voice and the Orb
    // overlay; `jarvis serve` is the headless server whose full experience,
    // microphone included, lives in the browser.
    body: "`jarvis` opens the desktop window with voice and the Orb overlay. On a server, `jarvis serve` runs the same assistant in a browser tab, microphone and all.",
    cta: false,
  },
];

/** Backticks in a body become real code spans; the copy is authored here. */
function segments(body: string) {
  return body
    .split(/`([^`]+)`/)
    .map((text, i) => ({ text, code: i % 2 === 1 }));
}
---

<section id="install">
  {/*
    The line the section opens on, like every other section. It stays put and
    scrolls away; the frame's own top line below is the one that gets pinned.
  */}
  <Container width="content">
    <div class="section-rule"></div>
  </Container>

  {/*
    THE SCROLL TRACK. The section stops under the reader and the four steps
    take their turn one at a time, which is what the maintainer asked for
    (2026-08-29) and what the file used to forbid in as many words.

    Same construction as VoiceSwitch, deliberately: the track's only job is to
    be tall, the sticky child inside it is the single screen anyone sees, and
    `track - viewport` of scrolling is the running length the steps are spread
    over. See docs/layout.md, "A section that is one viewport and still
    scrolls".

    Below the breakpoints in the styles the track collapses to `auto`, the
    child goes static and this is an ordinary block with four steps in it. A
    scroll trap is only worth it where the whole frame actually fits on the
    screen.
  */}
  <div data-track data-scroll-span>
    <div data-viewport>
      <Container width="content" class="flex h-full min-h-0 flex-col">
        {/*
          The pinned frame — the section as the reader sees it, a box closed on
          all four sides: the rails give the two verticals, these two rules the
          horizontals. The section marker walks that perimeter, so it lives in
          HERE and not on the section: the section element is several screens
          tall and a marker halfway down it would be a screen below the fold.
        */}
        <div data-frame>
          <SectionTrack nested />
          <p class="eyebrow uppercase text-muted">Getting started</p>
          <h2 class="headline mt-4 text-balance">How to install Jarvis</h2>

          <div class="mt-10 grid gap-12 lg:grid-cols-12">
            <ol class="relative lg:col-span-6" data-steps>
              {
                steps.map((step, i) => (
                  <li class="step relative pl-10 [&:not(:last-child)]:mb-10" data-step>
                    {/*
                      The connecting hairline, drawn as one segment PER GAP rather
                      than as a single line down the list. A single line is spanned
                      against the <ol>, whose box ends at the bottom of the last
                      step's body — several lines below the last badge — so it ran
                      on past the final number into empty space. A segment knows
                      where it has to stop: it starts at its own badge's bottom
                      edge and reaches exactly one step gap down (`-bottom-10`
                      against `mb-10`), to the top of the next badge. The last step has no gap under it and therefore
                      draws nothing.
                    */}
                    {i < steps.length - 1 && (
                      <span
                        aria-hidden="true"
                        class="absolute -bottom-10 left-3 top-6 w-px bg-hairline"
                      />
                    )}

                    <span class="badge absolute left-0 top-0 grid h-6 w-6 place-items-center rounded-[var(--radius-xs)] border border-hairline bg-canvas font-mono text-muted">
                      {i + 1}
                    </span>

                    <h3 class="step-title font-medium text-ink">{step.title}</h3>

                    <p class="step-body mt-2 text-body">
                      {segments(step.body).map((part) =>
                        part.code ? <code>{part.text}</code> : <Fragment>{part.text}</Fragment>,
                      )}
                    </p>

                    {step.cta && (
                      <div class="mt-4">
                        <InstallCommand />
                      </div>
                    )}
                  </li>
                ))
              }
            </ol>

            {/*
              Decorative, and gone below 1024px rather than shrunk. `client:media`
              means the WebGL bundle is never even fetched on a phone.

              The frame is a GRID, not a block. Astro wraps a client component in
              `<astro-island>`, a custom element that defaults to `display: inline`
              — a percentage height inside one resolves to nothing and the mark
              renders a few pixels wide. A grid item is blockified whatever its own
              display says, which makes the island fill the frame.
            */}
            <div class="mark-frame hidden lg:col-span-6 lg:grid">
              <TurningMark client:media="(min-width: 1024px)" />
            </div>
          </div>
        </div>
      </Container>
    </div>
  </div>

  {/*
    The line the band hangs off. The frame's own bottom rule closes the steps
    while they are pinned; this one closes the track, and the band sits
    straight on it.
  */}
  <Container width="content">
    <div class="section-rule"></div>
  </Container>

  {/*
    The closing band, inside the section rather than after it.

    It used to be a sibling of the section, and that is what produced the hole
    the maintainer photographed: the steps claimed a whole viewport and centred
    ~800px of content in it, so the leftover height fell as dead space BELOW
    the last step — and the band began under all of it. Inside the section the
    same leftover height is spent instead of wasted: `flex-1` hands it to the
    steps, the band is pinned to the bottom of the viewport, and the two read
    as one closing screen.

    The gap over the band is a gap, not a join — the same relationship the
    reference (meuze.ai) has between its bordered block and the band beneath
    it. The tail under it is what keeps the band from sitting on the very edge
    of the screen.

    Sharp corners, flat ink, no gradient. It breaks with everything above it on
    purpose. On this palette the accent IS the ink — docs/design.md keeps one
    action colour and no borrowed hue — so the band is paper and its type is
    the page floor, 18.5:1, well past AA.
  */}
  <div class="install-close">
    <Container width="content">
      <div
        class="cta flex flex-col justify-between gap-8 rounded-none bg-ink p-8 text-on-ink md:min-h-[220px] md:flex-row md:items-center md:p-10"
      >
        <div>
          <h2 class="headline text-balance leading-tight">
            Talk to your computer.<br />It does the thing.
          </h2>
          <p class="cta-sub mt-4 opacity-70">
            Apache 2.0, running on your own machine. Bring the AI subscription
            you already pay for, or an API key, or nothing at all and keep it
            offline.
          </p>
        </div>

        <a
          href={`${REPO}#install`}
          class="action inline-flex h-11 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-on-ink px-6 font-medium text-ink transition-opacity hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-ink"
        >
          Install Personal Jarvis
        </a>
      </div>
    </Container>
  </div>
</section>

<style>
  /* --- The track and its one visible screen -------------------------------
   *
   * `--track` is the running length. The reader scrolls (track - viewport) of
   * distance, and the four steps are spread over it: a quarter each, so every
   * step gets its own stretch of scrolling and the section only lets go once
   * the fourth has had it. Four and a half screens is what makes a step feel
   * like a beat rather than a flicker, without the page seeming to have
   * stopped working.
   */
  [data-track] {
    --track: 400svh;

    height: var(--track);
  }

  [data-viewport] {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-block: var(--space-xl);
    overflow: hidden;
  }

  /* --- The pinned frame --------------------------------------------------
   * The section drawn as a box: the rails give the two sides, these two rules
   * close it top and bottom, and the section marker walks that perimeter.
   * `--rule`, not `--hairline` — this is the page's structure, the same line
   * the rails and every `.section-rule` draw.
   *
   * Inset from the sticky viewport rather than flush with it: a closing line
   * lying exactly on the bottom edge of the window is a line nobody sees.
   *
   * `min-height: 0` carries the flex chain on from the container. One missing
   * link and the content leaves the bottom of the frame instead of the frame
   * getting shorter — docs/layout.md says so, and it is the first thing to
   * check if the steps ever run out through the bottom rule.
   */
  [data-frame] {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    border-block: 1px solid var(--rule);
    padding-block: var(--space-lg);
  }

  /* NOTHING above the band: it hangs off the rule that closes the steps, the
     way every other block on this site hangs off its own rule. A gap was tried
     — the reference has one — and the maintainer struck it out on sight
     (2026-08-29), because our band is a filled block rather than a floating
     card: the space read as a hole between the steps and the end of the page,
     not as air around a card.

     Below it, the tail keeps the band off the bottom edge of the screen and
     opens the distance to the legal foot underneath. Whatever the removed gap
     freed goes to the steps, not back into these numbers: `flex-1` grows only
     Block A. */
  .install-close {
    padding-block: 0 clamp(1.25rem, 2.75svh, 2rem);
  }

  .eyebrow {
    font-size: var(--text-caption-upper);
    letter-spacing: var(--tracking-caption-upper);
    font-family: var(--font-mono);
  }

  .headline {
    font-size: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    line-height: 1.2;
  }

  .step-title {
    font-size: var(--text-title-md);
  }

  .step-body {
    font-size: var(--text-body-sm);
  }

  .badge {
    font-size: var(--text-caption-upper);
  }

  .action {
    font-size: var(--text-body-sm);
  }

  .cta-sub {
    font-size: var(--text-body-sm);
  }

  /* The band's heading has to be stated here, not with a `text-on-ink`
     utility. Tailwind v4 puts utilities in `@layer utilities`, and global.css
     colours h1-h4 from an UNLAYERED rule — unlayered always beats layered,
     whatever the specificity. The utility loses silently and the heading comes
     out paper-on-paper: invisible. */
  .cta .headline {
    color: var(--on-ink);
  }

  /* The dimming only exists once the script has opted in. Without it — no
     JavaScript, or reduced motion — every step reads at full strength. */
  [data-focus] .step {
    opacity: 0.35;
    transition: opacity 300ms ease;
  }

  [data-focus] .step[data-active],
  [data-focus] .step:hover {
    opacity: 1;
  }

  /* The active number is filled, the rest are outlines. */
  [data-focus] .step[data-active] .badge {
    background: var(--surface-strong);
    border-color: var(--surface-strong);
    color: var(--ink);
  }

  /* The frame takes the whole cell — its column's width, its row's height —
     and the mark is drawn as large as that box allows, centred in it.

     It used to be a square with a viewport cap (`aspect-ratio: 1`,
     `max-height: 44svh`), and both were wrong for the same reason: they sized
     the graphic against the SCREEN rather than against the section it lives in
     (maintainer, 2026-08-29). A square in a taller row throws the extra height
     away, and because a grid item with a fixed aspect ratio cannot stretch, the
     square sat at the TOP of the row while the steps ran on past it — the mark
     read as floating in the upper corner with a hole underneath.

     Nothing here needs a cap: the row is only ever as tall as the steps, so
     the mark cannot outgrow the section it is framed against. */
  .mark-frame {
    min-height: 0;
  }

  /* --- Where the pin is off ----------------------------------------------
   * Three cases drop out of the sticky layout into an ordinary block, and each
   * one is the same judgement: pinning is only worth it where the whole frame
   * actually fits on the screen with room to read it.
   *
   *   narrow    under 1280px the steps column is narrow enough that the four
   *             bodies wrap to five and six lines, and the frame is taller
   *             than any window
   *   short     measured, not assumed: the frame's natural height runs 950px
   *             at 1280 wide to 972px at 2560 (the root scale grows with the
   *             viewport), plus 64px of padding on the sticky child — so the
   *             pin needs about 1040px of window and gives up below it. Under
   *             that the frame would be shorter than its content, and the
   *             sticky child clips what will not fit
   *   calm      prefers-reduced-motion. A section that holds the page still
   *             is exactly what that setting is asking not to happen
   *
   * The script reads the same query, spelled identically, so the CSS and the
   * JS cannot disagree about which mode the section is in — a mismatch leaves
   * a scrub driving a section that no longer has a track.
   */
  @media (max-width: 1279px), (max-height: 1039px), (prefers-reduced-motion: reduce) {
    [data-track] {
      height: auto;
    }

    [data-viewport] {
      position: static;
      height: auto;
      padding-block: var(--space-xxl);
      overflow: visible;
    }

    /* Nothing is pinned, so there is no box for a perimeter to be the
       perimeter of. The section keeps the rule at its top and the one the band
       hangs from, like every other section on the page. */
    [data-frame] {
      border-block: 0;
      padding-block: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-focus] .step {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Which step is active, and where that answer comes from.
   *
   * WHILE THE SECTION IS PINNED NOTHING MOVES, so the rule this used to run on
   * — whichever step's centre is closest to the middle of the window — returns
   * the same step on every frame of the pin. The answer comes from the TRACK
   * instead: how far the reader is through it, split four ways in order, so
   * each step owns a quarter of the scrolling and the section only lets go
   * once the fourth has had its share.
   *
   * `spanProgress` is the same function the section marker and the voice wipe
   * measure with. Three things draw this page's scroll position and one
   * formula decides it, or they drift apart in the way a reader actually
   * notices: the last step lighting up before the marker reaches the corner.
   *
   * WHERE THE PIN IS OFF the old rule is still the right one, because the
   * steps are ordinary blocks moving up the screen again. The media query is
   * the stylesheet's, spelled identically — the CSS decides the geometry and
   * this decides where the value comes from, and a mismatch leaves a scrub
   * driving a section that no longer has a track.
   *
   * Every read is inside a requestAnimationFrame. `getBoundingClientRect`
   * forces layout, and doing that in the scroll handler ties the page's frame
   * rate to the wheel.
   */
  import { spanProgress } from "@/lib/scrollSpan";

  const section = document.querySelector<HTMLElement>("#install");
  const list = section?.querySelector<HTMLElement>("[data-steps]");
  const track = section?.querySelector<HTMLElement>("[data-track]");

  if (section && list && track) {
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-step]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const loose = window.matchMedia(
      "(max-width: 1279px), (max-height: 1039px), (prefers-reduced-motion: reduce)",
    );

    if (!reduce.matches && items.length > 0) {
      list.dataset.focus = "";

      let active = -1;
      let frame = 0;

      const apply = (next: number) => {
        if (next === active) return;
        active = next;

        items.forEach((item, i) => {
          item.toggleAttribute("data-active", i === next);
        });
      };

      /* A quarter of the track each. `Math.min` rather than a clamp because
         the only value that overruns is a progress of exactly 1, at the last
         pixel of the pin, and it belongs to the last step. */
      const fromTrack = () => {
        const progress = spanProgress(track.getBoundingClientRect(), window.innerHeight);
        return Math.min(items.length - 1, Math.floor(progress * items.length));
      };

      const fromCentre = () => {
        const middle = window.innerHeight / 2;
        let best = 0;
        let bestDistance = Infinity;

        items.forEach((item, i) => {
          const rect = item.getBoundingClientRect();
          const distance = Math.abs(rect.top + rect.height / 2 - middle);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
          }
        });

        return best;
      };

      const measure = () => {
        frame = 0;
        apply(loose.matches ? fromCentre() : fromTrack());
      };

      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(measure);
      };

      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      loose.addEventListener("change", schedule);
      measure();
    }
  }
</script>
