---
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import AgentsDemo from "@/components/agents-demo/AgentsDemo";
---

<!-- Last feature in the shared run: copy and painted well match CLIs. -->
<section id="agents" class="relative flex flex-col" aria-label="Jarvis Agents">
  <SectionTrack open />
  <Container width="content" class="section-inset flex min-h-0 flex-1 flex-col">
    <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 px-8 lg:aspect-[16/9] lg:min-h-[560px] lg:grid-cols-12 lg:grid-rows-[minmax(0,1fr)] lg:p-14">
      <div class="lg:col-span-5">
        <p class="text-[22px] leading-snug sm:text-[26px]">
          <span class="font-medium text-ink">Your agents work as a team.</span>{" "}
          <span class="text-body">Give Jarvis a goal. Its specialists exchange messages, share context and report back. Open any agent's chat to steer the work directly.</span>
        </p>
      </div>
      <div class="min-h-0 min-w-0 lg:col-span-7 lg:h-full"><AgentsDemo client:visible /></div>
    </div>
  </Container>
</section>
