---
/**
 * The hero — one viewport tall, with the demo stage cropped at the bottom.
 * See docs/hero.md; this is the skeleton, the interactive stage lands later.
 */
import Container from "@/components/Container.astro";
---

<section class="relative flex min-h-svh flex-col overflow-hidden">
  <!-- Nav sits on the `full` step: background edge to edge, content inside. -->
  <header class="sticky top-0 z-30 h-16 border-b border-hairline bg-canvas">
    <Container width="content" class="flex h-16 items-center justify-between">
      <span class="text-[18px] font-semibold text-ink">Personal Jarvis</span>
      <nav class="flex items-center gap-6 text-[14px] font-medium text-body">
        <a href="#features" class="hover:text-ink">Features</a>
        <a href="#docs" class="hover:text-ink">Docs</a>
        <a
          href="#install"
          class="rounded-md bg-ink px-5 py-3 text-on-ink hover:bg-ink-active"
        >
          Download
        </a>
      </nav>
    </Container>
  </header>

  <div class="flex flex-1 flex-col items-center justify-end pb-12 pt-20">
    <Container width="prose">
      <h1
        class="text-balance text-center leading-[1.05] tracking-[-2.16px]"
        style="font-size: clamp(2rem, 6vw, 4.5rem)"
      >
        Speak to your computer, and it does the work
      </h1>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="#install"
          class="rounded-md bg-ink px-5 py-3 text-center text-[14px] font-medium text-on-ink hover:bg-ink-active"
        >
          Download for Windows
        </a>
        <a
          href="#docs"
          class="rounded-md border border-hairline-strong bg-card px-5 py-3 text-center text-[14px] font-medium text-ink"
        >
          Read the docs
        </a>
      </div>
    </Container>
  </div>

  <!--
    The stage overruns the section edge and the section clips it. The cut-off
    border is the scroll cue — see docs/hero.md, "The crop".
  -->
  <Container width="content" class="shrink-0">
    <div
      class="translate-y-8 overflow-hidden rounded-lg border border-hairline bg-card"
      style="aspect-ratio: 16/10"
      aria-hidden="true"
    >
      <div class="h-full w-full bg-canvas-soft"></div>
    </div>
    <p class="sr-only">
      Interactive demo with two windows: the main workspace and a voice panel.
    </p>
  </Container>
</section>
