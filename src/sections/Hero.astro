---
/**
 * The hero — one viewport tall, with the demo stage cropped at the bottom.
 * See docs/hero.md.
 *
 * Vertical structure is a three-row grid, not a flex column with justify-end:
 * flex pushed the whole block to the bottom and left a dead field above the
 * headline. The rows are nav / copy / stage, and only the stage row flexes, so
 * the copy keeps its position near the top at any viewport height.
 *
 * Spacing above the copy is in `svh`, so the proportions hold on a short laptop
 * screen and a tall monitor alike. Target at 1440x900: headline top ~13%,
 * CTAs ~31%, stage top ~37%.
 */
import Container from "@/components/Container.astro";
import DemoStage from "@/components/demo/DemoStage";
---

<section class="grid min-h-svh grid-rows-[auto_auto_1fr] overflow-hidden">
  <!-- Nav sits on the `full` step: background edge to edge, content inside. -->
  <header class="sticky top-0 z-30 h-16 border-b border-hairline bg-canvas">
    <Container width="content" class="flex h-16 items-center justify-between">
      <span class="text-[18px] font-semibold text-ink">Personal Jarvis</span>
      <nav class="flex items-center gap-7 text-[14px] font-medium text-body">
        <a href="#features" class="hover:text-ink">Features</a>
        <a href="#docs" class="hover:text-ink">Docs</a>
        <a
          href="#install"
          class="rounded-full bg-ink px-5 py-2.5 text-on-ink transition-colors hover:bg-ink-active"
        >
          Download
        </a>
      </nav>
    </Container>
  </header>

  <div class="pt-[6svh]">
    <Container width="prose">
      <h1
        class="text-center text-balance leading-[1.05] tracking-[-2px]"
        style="font-size: clamp(2.25rem, 1.6rem + 2.4vw, 6rem)"
      >
        Speak to your computer and it does the work
      </h1>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="#install"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-ink px-6 text-[15px] font-medium text-on-ink transition-colors hover:bg-ink-active"
        >
          Download for Windows
        </a>
        <a
          href="#docs"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-hairline-strong bg-card px-6 text-[15px] font-medium text-ink transition-colors hover:border-ink"
        >
          Read the docs
        </a>
      </div>
    </Container>
  </div>

  <!--
    The stage overruns the section edge and the section clips it. The cut-off
    border is the scroll cue — see docs/hero.md, "The crop".
  -->
  <Container width="content" class="pt-6">
    <!--
      `hairline-strong`, not the usual hairline: the mockup carries the app's
      own near-black, which on this page floor is within a shade of it. On the
      old cream page the window read as elevated by its fill alone; here the
      edge is the only thing separating the two, so it has to be the stronger
      one. See tokens.css, "App mockup".
    -->
    <div class="overflow-hidden rounded-2xl border border-hairline-strong">
      <DemoStage client:load />
    </div>
  </Container>
</section>
