---
/**
 * The legal foot of the page — everything under the closing band.
 *
 * It is a `<footer>` of its own rather than part of the install section,
 * because the section is one screen and this deliberately is not: the band is
 * the last thing a reader is meant to SEE, and this is the material they go
 * looking for.
 *
 * NOTHING HERE IS DRAFTED. Every line is a fact the repository can prove, and
 * each carries the file that proves it. A footer is the one place on a site
 * where an invented sentence is not a copy problem but a legal one, so the
 * rule is stricter than the rest of the page: no claim without a source, and
 * no link to a document that does not exist yet.
 *
 * THE FOOT DRAWS NO PAGE STRUCTURE. No rails, no band, no boundary rule — the
 * page's structural lines stop under the closing CTA and this block stands on
 * open ground (maintainer, 2026-08-29). The one line it does draw is the
 * hairline over its last row, which separates two parts of the same block
 * rather than one section from another.
 *
 * See docs/footer.md.
 */
import Container from "@/components/Container.astro";
import { REPO } from "@/lib/install";
import { SOCIAL_STATS, type SocialId } from "@/lib/socialCounts";

/**
 * The accounts, by platform name.
 *
 * The handles themselves are NOT written here. `socialCounts.ts` is the one
 * place the site states which account is which — the X account is a personal
 * one and the project-named profile is defunct, so a handle typed from memory
 * points at a dead page. This map only turns its ids into the words a reader
 * recognises, which is the one thing that file has no opinion about.
 *
 * GitHub is deliberately absent: the repository is already the first entry
 * under "Project", and the same destination twice in one footer reads as an
 * oversight rather than as emphasis.
 */
const PLATFORM_NAMES: Partial<Record<SocialId, string>> = {
  youtube: "YouTube",
  x: "X",
  discord: "Discord",
};

/**
 * The columns, in the order someone looks for them: what the project is,
 * then what it is licensed under, then where it can be followed.
 *
 * Every href is a real file or a real account. A link here that 404s is worse
 * than no link, so each one is checked against the repository before it is
 * added — see docs/footer.md § "The rule this file exists for".
 */
const groups = [
  {
    label: "Project",
    links: [
      { label: "Source", href: REPO },
      // The docs live in the repository; this site has no /docs route yet.
      { label: "Docs", href: `${REPO}/tree/main/docs` },
      { label: "Security", href: `${REPO}/blob/main/SECURITY.md` },
    ],
  },
  {
    label: "Legal",
    links: [
      // README § License: "Apache 2.0. Free to use, modify, and distribute…"
      { label: "License", href: `${REPO}/blob/main/LICENSE` },
      // README § License names NOTICE alongside LICENSE.
      { label: "Notice", href: `${REPO}/blob/main/NOTICE` },
      // README § License: "Third-party names and logos belong to their owners."
      { label: "Trademarks", href: `${REPO}/blob/main/TRADEMARK.md` },
      // README § License: docs/licensing.md says why the licence changed.
      { label: "Licensing history", href: `${REPO}/blob/main/docs/licensing.md` },
    ],
  },
  {
    label: "Follow",
    links: SOCIAL_STATS.filter((s) => PLATFORM_NAMES[s.id]).map((s) => ({
      label: PLATFORM_NAMES[s.id] as string,
      href: s.href,
    })),
  },
];

/** The copyright year is the year the page is built, not a literal. */
const year = new Date().getFullYear();
---

<footer class="legal">
  <Container width="content">
    <div class="legal-inner">
      <div class="legal-top">
        <!-- Who the page belongs to, and the two claims the project actually
             makes. This is the column the reader lands in; the link columns
             beside it are what they came to click. -->
        <div class="legal-identity">
          <p class="legal-mark">Personal Jarvis</p>

          <div class="legal-fine">
            {/*
              README § License, verbatim in substance: Apache 2.0 with an
              explicit patent grant, and every release up to 1.6.0 stays MIT
              permanently.
            */}
            <p>
              Free to use, modify and distribute, commercially included, with a
              patent grant from every contributor. Releases up to 1.6.0 remain
              MIT, permanently. Third-party names and logos belong to their
              owners.
            </p>

            {/*
              A claim about THIS page, and true of this build: no analytics
              script, no font CDN, no cookie is set anywhere in `src/`, and the
              video section holds a local JPEG until the reader presses play —
              see the comment on the stage in BuiltInPublic.astro. If any of
              that changes, this sentence changes with it.
            */}
            <p>
              This page sets no cookies and runs no analytics. It loads nothing
              from anyone else until you press play on a video, which is the
              moment YouTube is contacted and not before.
            </p>
          </div>
        </div>

        <nav class="legal-groups" aria-label="Project, legal and social links">
          {
            groups.map((group) => (
              <div class="legal-group">
                <p class="legal-group__label" id={`legal-${group.label.toLowerCase()}`}>
                  {group.label}
                </p>
                <ul aria-labelledby={`legal-${group.label.toLowerCase()}`}>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>

      <!-- The last row: what holds, and under what. The hairline over it is
           the only line the footer draws. -->
      <div class="legal-baseline">
        <p>&copy; {year} the Personal Jarvis contributors</p>
        <p>Apache 2.0</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .legal {
    position: relative;
    padding-block: var(--section-inset);
  }

  /* THE GROUND IS WHAT ENDS THE RAILS, and it reaches up BEHIND the closing
     CTA to do it.

     The rails are a fixed layer the full height of the window, so nothing in
     the flow can shorten them — they ran the length of the footer and out of
     the bottom of the screen. A ground painted over them ends them, because a
     painted box wins against `z-index: -1`.

     WHY A PSEUDO-ELEMENT AND NOT `background` ON THE FOOTER. The page's lines
     have to stop under the white CTA band, and between that band and the top
     of this footer sits the install section's own closing padding — 48px when
     the section is unpinned, 24px when it is pinned. A background on the
     footer starts below that gap and leaves a stub of rail under the band, in
     one of the two states or the other; a negative margin would have to name
     whichever figure is live, and that is the "spell the same condition twice"
     bug docs/layout.md keeps warning about.

     So the ground overshoots by `--space-section` and hides the difference. It
     is safe to overshoot because of the layer it is on:

       - `z-index: -1` puts it in the same layer as the rails. PageChrome is
         rendered before the page content, so at equal z-index this box paints
         LATER and therefore on top — the rails end where it begins.
       - The CTA band is inside a `position: sticky` viewport, so it is a
         positioned box in the normal layer and paints above anything at a
         negative index. The part of the overshoot that lands on the band is
         behind it and cannot be seen.

     The overshoot is smaller than the band is tall, so it can never reach past
     it into the section above, where the rails must still be drawn.

     `--canvas` explicitly, never `transparent` or `inherit` — the whole job of
     this box is that it PAINTS. It is the same black `body` already carries
     (global.css § "One ground"), so no colour on the page changes; only what
     stands in front of the chrome layer does. */
  .legal::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset-inline: 0;
    inset-block: calc(-1 * var(--space-section)) 0;
    background: var(--canvas);
    pointer-events: none;
  }

  /* Identity on the left, three columns of links across the rest.

     A SHARE EACH, not `auto`. Sized to their content the three columns bunch
     up against the right edge — 59, 122 and 63 pixels wide with the whole
     middle of the foot empty behind them, which reads as text pushed aside
     rather than as a layout. Two fifths to the identity block and a fifth to
     each column puts them where the reference has them: evenly spaced across
     the width, each label starting a column the eye can follow down.

     `minmax(0, …)` on every track, because a grid track's default floor is its
     content and "Licensing history" would otherwise refuse to let the row
     narrow. */
  .legal-top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    column-gap: var(--space-xl);
    row-gap: var(--space-section);
    align-items: start;
  }

  /* The wordmark is the one step up in size on the whole foot. Without it the
     block is a single grey field of small type; with it the identity column
     has something to hang off. */
  .legal-mark {
    font-size: var(--text-title-sm);
    color: var(--ink);
  }

  /* The fine print keeps a prose MEASURE inside its own column — a `ch` limit
     is what "readable line length" protects, and it does not put a second left
     edge on the page the way a prose container would. */
  .legal-fine {
    margin-top: var(--space-md);
    max-inline-size: 54ch; /* layout-allow: a measure in ch, not a layout width — the block still sits in the content container */
    display: grid;
    gap: var(--space-sm);
    font-size: var(--text-caption);
    /* `--muted`, not `--muted-soft`. On this canvas the soft tone is 3.7:1,
       under AA for text this size — and legal wording is the last thing on a
       page that may be hard to read. The brighter muted tone is 6.7:1. */
    color: var(--muted);
  }

  .legal-groups {
    display: contents;
  }

  .legal-group__label {
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
    color: var(--muted);
  }

  .legal-group ul {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: var(--text-body-sm);
  }

  .legal-group a {
    color: var(--body);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .legal-group a:hover,
  .legal-group a:focus-visible {
    color: var(--ink);
  }

  /* The only line this block draws, and it is `--hairline` on purpose.
     `--rule` is the page's structural colour — the rails and the section
     boundaries — and that is exactly what the foot no longer carries. This
     separates the last row from the block above it, which is an edge inside
     one thing rather than a boundary between two. */
  .legal-baseline {
    margin-top: var(--space-section);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--text-caption);
    color: var(--muted);
  }

  /* Below the container's breakpoint the four columns have nowhere to go. The
     identity block keeps the full width and the three link columns sit beside
     each other underneath it — still columns, because a label with two or
     three links under it is what makes them readable at all, and still a row,
     because stacking them turns the foot into a screen of its own. */
  @media (max-width: 767px) {
    .legal-top {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-xxl);
    }

    .legal-groups {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xxl) var(--space-section);
    }

    .legal-baseline {
      margin-top: var(--space-xxl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-group a {
      transition: none;
    }
  }
</style>
