---
/**
 * The legal foot of the page — everything under the closing band.
 *
 * It is a `<footer>` of its own rather than part of the install section,
 * because the section is one screen and this deliberately is not: the band is
 * the last thing a reader is meant to SEE, and this is the material they go
 * looking for. It sits just under the fold, on the same two rails as
 * everything above it.
 *
 * NOTHING HERE IS DRAFTED. Every line is a fact the repository can prove, and
 * each carries the file that proves it. A footer is the one place on a site
 * where an invented sentence is not a copy problem but a legal one, so the
 * rule is stricter than the rest of the page: no claim without a source, and
 * no link to a document that does not exist yet.
 *
 * See docs/footer.md.
 */
import Container from "@/components/Container.astro";
import { REPO } from "@/lib/install";

/**
 * The documents, in the order someone looks for them. Each is a real file at
 * the top of the repository — a link here that 404s is worse than no link.
 */
const documents = [
  // README § License: "Apache 2.0. Free to use, modify, and distribute…"
  { label: "License", href: `${REPO}/blob/main/LICENSE` },
  // README § License names NOTICE alongside LICENSE.
  { label: "Notice", href: `${REPO}/blob/main/NOTICE` },
  // README § License: "Third-party names and logos belong to their owners."
  { label: "Trademarks", href: `${REPO}/blob/main/TRADEMARK.md` },
  { label: "Security", href: `${REPO}/blob/main/SECURITY.md` },
  // README § License: docs/licensing.md says why the licence changed.
  { label: "Licensing history", href: `${REPO}/blob/main/docs/licensing.md` },
  { label: "Source", href: REPO },
];

/** The copyright year is the year the page is built, not a literal. */
const year = new Date().getFullYear();
---

<!-- The standard section shell, footer included. It is the last band on the
     page and there is no reason for the last boundary to be the one that is
     shaped differently — see docs/layout.md § "One boundary, one shape". No
     `SectionTrack`: the marker walks the sections a reader scrolls THROUGH,
     and this is the end of the page.

     The one thing about this band that is not like the others is who pays for
     the air under its closing rule. Everywhere else that is the Container's
     padding; here it is `.section-close`, a painted block of the same height.
     The rails are a fixed layer nothing in the flow can shorten, so the only
     way they end at the last rule instead of running out of the window under
     it is for something opaque to stand in front of them. -->

<footer class="legal relative flex flex-col">
  <Container width="content" class="section-inset section-inset--close flex min-h-0 flex-1 flex-col">
    <div class="section-bounds legal-inner">
      <!-- Who the page belongs to, and under what. Two lines rather than one
           run of text with a separator in it: the name is the anchor of the
           block and the licence is the answer to the first question anyone
           has about it, and neither is a caption of the other. -->
      <div class="legal-identity">
        <p class="legal-mark">Personal Jarvis</p>
        <p class="legal-licence">Apache 2.0</p>
      </div>

      <!-- The documents stand as a column on the right rail rather than a row
           under the name. Six labels in a row ran the full width of the
           content column and left the whole right half of the foot empty
           under it; as a column they fill that half, the fine print keeps its
           measure on the left, and the two blocks close the page as one
           spread instead of two ragged lines. -->
      <nav class="legal-docs" aria-label="Legal and project documents">
        <ul>
          {
            documents.map((doc) => (
              <li>
                <a href={doc.href} target="_blank" rel="noopener">
                  {doc.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="legal-fine">
        {/*
          README § License, verbatim in substance: Apache 2.0 with an explicit
          patent grant, and every release up to 1.6.0 stays MIT permanently.
        */}
        <p>
          Free to use, modify and distribute, commercially included, with a
          patent grant from every contributor. Releases up to 1.6.0 remain MIT,
          permanently. Third-party names and logos belong to their owners.
        </p>

        {/*
          A claim about THIS page, and true of this build: no analytics script,
          no font CDN, no cookie is set anywhere in `src/`, and the video
          section holds a local JPEG until the reader presses play — see the
          comment on the stage in BuiltInPublic.astro. If any of that changes,
          this sentence changes with it.
        */}
        <p>
          This page sets no cookies and runs no analytics. It loads nothing from
          anyone else until you press play on a video, which is the moment
          YouTube is contacted and not before.
        </p>

        <p class="legal-copyright">&copy; {year} the Personal Jarvis contributors</p>
      </div>
    </div>
  </Container>

  <!-- The page's last inset. It is a real element rather than padding for one
       reason: it has to PAINT, so the rails stop on the rule above it instead
       of running out of the bottom of the window. Decorative and empty, so it
       is hidden from the accessibility tree. -->
  <div class="section-close" aria-hidden="true"></div>
</footer>

<style>
  /* No `padding-block` here any more. It used to be a pair of clamps of this
     footer's own, which is how the page ended up with six different figures
     between a rule and the thing under it; the band supplies `--section-pad`
     like every other section now. */

  /* Two columns: everything that reads left to right on the left, the document
     list held against the right rail. The list spans both rows so it starts on
     the name's baseline and runs down beside the fine print.

     NO PADDING OR BORDER ON THE INLINE AXIS. This element is `.section-bounds`,
     which is laid directly against the rails; inline padding here would pull
     the two rules off them (docs/layout.md § "The marker has to be re-pointed
     at the band"). The columns are a grid gap, which costs neither. */
  .legal-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "identity docs"
      "fine     docs";
    column-gap: var(--space-xxl);
    row-gap: var(--space-xl);
    align-items: start;
  }

  .legal-identity {
    grid-area: identity;
  }

  /* The one step up in size on the whole foot, and it is what makes the block
     read as a signature rather than as more fine print. Everything else here
     stays at `--text-caption`. */
  .legal-mark {
    font-size: var(--text-title-sm);
    color: var(--ink);
  }

  .legal-licence {
    margin-top: var(--space-xxs);
    font-size: var(--text-caption);
    color: var(--body);
  }

  .legal-docs {
    grid-area: docs;
    justify-self: end;
  }

  .legal-docs ul {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
    font-size: var(--text-caption);
  }

  .legal-docs a {
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .legal-docs a:hover,
  .legal-docs a:focus-visible {
    color: var(--ink);
  }

  /* The fine print keeps a prose MEASURE without leaving the content column —
     a `ch` limit is what "readable line length" actually protects, and it does
     not put a second left edge on the page the way a prose container would. */
  .legal-fine {
    grid-area: fine;
    max-inline-size: 78ch; /* layout-allow: a measure in ch, not a layout width — the block still sits in the content container */
    font-size: var(--text-caption);
    /* `--muted`, not `--muted-soft`. On this canvas the soft tone is 3.7:1,
       under AA for text this size — and legal wording is the last thing on a
       page that may be hard to read. The brighter muted tone is 6.7:1. */
    color: var(--muted);
    display: grid;
    gap: var(--space-sm);
  }

  /* The last line of the page, and it gets air of its own so it is not read as
     a third clause of the sentence above it. */
  .legal-copyright {
    margin-top: var(--space-md);
  }

  /* Below the container's breakpoint the two columns have nowhere to go: the
     rails are gone, the measure is the screen, and a column of six labels held
     against a right edge that no longer exists reads as a stray block. They
     stack, and the list goes back to a wrapping row — which is what it was
     built as, and what it is good at when it has the full width. */
  @media (max-width: 767px) {
    .legal-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "identity"
        "docs"
        "fine";
      row-gap: var(--space-lg);
    }

    .legal-docs {
      justify-self: start;
    }

    .legal-docs ul {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-xs) var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-docs a {
      transition: none;
    }
  }
</style>
