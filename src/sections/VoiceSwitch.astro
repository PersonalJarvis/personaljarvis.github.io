---
/**
 * Section 3 — what changes when you stop typing.
 *
 * Two photographs of one desk, a minute apart, printed as a one-bit pixel
 * dither. In the first the screen is packed with windows and the person is
 * bent over the keyboard; in the second the screen is calm, both hands are
 * away from it, and the person is talking. The contrast IS the argument.
 * See docs/section-3-voice.md.
 *
 * The frames cross-fade on OPACITY and nothing else. A slide or a wipe says
 * "somewhere else"; the claim here is "the same place, a different state", and
 * the camera holding still is what makes it land — measured, not assumed: the
 * desk edge sits within 3px and the mug within 1px across the pair.
 *
 * The pictures carry the change; the words carry the product. Someone who only
 * looks at the two frames learns that hands come off the keyboard, which is not
 * the same as learning what Jarvis is. That is what the standfirst and the
 * per-state captions are for, and why they describe the app rather than the
 * photograph.
 *
 * Widths come from the `.layout` grid in src/styles/layout.css: eyebrow,
 * headline and standfirst sit on the `prose` column, the tabs, the picture,
 * the caption and the figures on `content`. That grid is what lets one section
 * carry two width steps without naming a max-width of its own — which
 * docs/layout.md forbids and scripts/check-style.mjs enforces.
 *
 * There is no scroll indicator in here. The reader's position through the PAGE
 * is PageChrome's marker on the left rail; a second one scoped to one section
 * would answer a question nobody asked and disagree with the first.
 */
import Container from "@/components/Container.astro";

/**
 * `?url` rather than astro:assets: these are 640x360 one-bit dither, and the
 * build's image pipeline would re-encode them. Every dot carries tone here, and
 * they are 10-12 kB as they stand — there is nothing left to optimise.
 *
 * Regenerate with `python scripts/dither-scene.py <manual-src> <jarvis-src>`.
 * The palette is baked in, so a token change means re-running that script.
 */
import jarvisFrame from "@/assets/scene/jarvis.png?url";
import manualFrame from "@/assets/scene/manual.png?url";

/**
 * One caption per state, under the picture. Each says what the app does, not
 * what the photograph shows.
 *
 * Everything here is in the app README: the wake word you choose, the tool
 * model that decides how much a request needs, the coding-agent worker running
 * in an isolated copy of the workspace, and the answer spoken back in the
 * language you used. Nothing is a promise the app cannot keep.
 */
const captions = {
  manual: {
    lead: "Hands on the keyboard.",
    rest: "Every answer starts with you finding the window, the tab and the right button, and ends with you reading the result yourself.",
  },
  jarvis: {
    lead: "Hands nowhere near it.",
    rest: "You say it out loud. It picks the tools, takes the mouse if it has to, hands real work to an agent in an isolated copy of your files, and answers in the language you used.",
  },
};

/**
 * The figures under the picture. Each is countable in the app's own source;
 * none is a marketing number, and nothing here may be invented.
 *
 * They do NOT change with the state. Every provable figure is a fixed property
 * of the app with no "before" counterpart, and inventing one would be exactly
 * what docs/section-3-voice.md forbids. Approved by the maintainer 2026-08-28,
 * together with the decision that the bar stays static.
 */
const figures = [
  {
    value: "32",
    label: "Providers",
    // 12 brain + 8 speech-to-text + 8 text-to-speech + 4 realtime voice,
    // counted from the jarvis.* entry points in the app's pyproject.toml.
    note: "Brain, voice in, voice out",
  },
  { value: "3", label: "Platforms", note: "Windows, macOS, Linux" },
  { value: "< 1 s", label: "Spoken reply", note: "Realtime model" },
  { value: "4", label: "Channels", note: "One brain, one memory" },
];
---

<section
  id="voice"
  aria-labelledby="voice-heading"
  class="flex min-h-svh flex-col"
  data-voice-switch
  data-mode="manual"
>
  <!--
    The section rule, in the same container the rails stand on, so it starts
    and ends exactly on them. It is a child of the section rather than of the
    centred block below: the line marks where the section begins, and the
    block is free to sit in the middle of the leftover height.
  -->
  <Container width="content">
    <div class="section-rule"></div>
  </Container>

  <div class="flex flex-1 flex-col justify-center py-20">
    <div class="layout">
      <p class="text-center uppercase text-muted" data-voice-eyebrow>
        What changes
      </p>

      <h2
        id="voice-heading"
        class="mt-4 text-balance text-center"
        data-voice-headline
      >
        Most assistants talk back. This one does the thing.
      </h2>

      <p class="mt-5 text-balance text-center" data-voice-standfirst>
        Personal Jarvis runs on your own machine and answers to a name you pick.
        You speak; it works out what the request actually needs. Small things it
        does itself — opens the app, changes the setting, takes the mouse. Real
        work goes to a coding agent in an isolated copy of your files, gets
        checked, and comes back as a finished file instead of an answer.
      </p>

      <div
        class="wide mt-8 flex justify-center gap-2"
        role="tablist"
        aria-label="Two ways of working at the same desk"
      >
        <button
          type="button"
          role="tab"
          id="voice-tab-manual"
          aria-controls="voice-panel"
          aria-selected="true"
          tabindex="0"
          data-target="manual"
        >
          By hand
        </button>
        <button
          type="button"
          role="tab"
          id="voice-tab-jarvis"
          aria-controls="voice-panel"
          aria-selected="false"
          tabindex="-1"
          data-target="jarvis"
        >
          By voice
        </button>
      </div>

      <!--
        Both frames are stacked in the same box and only their opacity changes.
        Both are in the markup from the first paint — a frame fetched on the
        first switch flashes an empty box, which reads as a page bug rather
        than a transition.
      -->
      <div
        class="wide mt-8"
        id="voice-panel"
        role="tabpanel"
        aria-labelledby="voice-tab-manual"
        tabindex="0"
        data-stage
      >
        <img
          src={manualFrame}
          width="640"
          height="360"
          loading="eager"
          decoding="async"
          alt="A home office printed as fine dots of light. A person sits bent over the desk, both hands on the keyboard and one on the mouse, head down. The monitor is packed edge to edge with small overlapping windows. A mug and loose papers sit at the left, a bright window behind."
          data-frame="manual"
          data-active="true"
        />
        <img
          src={jarvisFrame}
          width="640"
          height="360"
          loading="eager"
          decoding="async"
          alt="The same desk, the same room, the same mug and papers, a minute later. The person has sat back in the chair with both hands away from the keyboard and mouse, head up, speaking out loud. The monitor now shows one calm, almost empty window."
          data-frame="jarvis"
          data-active="false"
        />
      </div>

      <p class="wide mt-6" data-caption>
        {
          (["manual", "jarvis"] as const).map((mode) => (
            <span data-caption-for={mode} hidden={mode !== "manual"}>
              <strong>{captions[mode].lead}</strong> {captions[mode].rest}
            </span>
          ))
        }
      </p>

      <dl class="wide mt-10" data-figures>
        {
          figures.map(({ value, label, note }) => (
            <div>
              <dt>
                <span data-figure-label>{label}</span>
                <span data-figure-note>{note}</span>
              </dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  [data-voice-eyebrow] {
    /* 14px from the token rather than Tailwind's `text-sm`: the tokens travel
     * with the root scale, so the label and the headline grow together. */
    font-size: var(--text-body-sm);
    letter-spacing: 0.1em;
  }

  [data-voice-headline] {
    font-size: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    line-height: 1.2;
  }

  [data-voice-standfirst] {
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* --- Tabs --------------------------------------------------------------
   * design.md's secondary control, promoted to the primary ink fill when
   * selected. One shape language: the 8px button radius, never a pill.
   */
  [role="tab"] {
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--body);
    padding: 0 20px;
    height: 40px;
    font-size: var(--text-body-sm);
    font-weight: 500;
    cursor: pointer;
  }

  [role="tab"]:hover {
    color: var(--ink);
  }

  [role="tab"][aria-selected="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  /* --- The picture -------------------------------------------------------- */
  [data-stage] {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    background: var(--canvas);
  }

  [data-frame] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* The frames are 640 wide and the box is wider. Without this the browser
     * smooths the dither into grey mush and the treatment is simply gone. */
    image-rendering: pixelated;
    transition: opacity 0.45s ease;
  }

  [data-frame][data-active="true"] {
    opacity: 1;
  }

  /* --- Caption -----------------------------------------------------------
   * Both captions reserve the same height, so switching does not shove the
   * figures up and down the page.
   */
  [data-caption] {
    margin: 0;
    min-height: 3lh;
    text-align: center;
    color: var(--muted);
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }

  [data-caption] strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* --- The figures -------------------------------------------------------
   * Hairlines are the 1px gaps of a grid on a hairline-coloured ground, the
   * same technique the logo strip uses. No borders are drawn.
   */
  [data-figures] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    margin: 0;
  }

  @media (min-width: 768px) {
    [data-figures] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  [data-figures] > div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--space-xxs);
    background: var(--canvas);
    padding: var(--space-lg) var(--space-base);
    text-align: center;
  }

  [data-figures] dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-display-md);
    letter-spacing: var(--tracking-display-md);
    line-height: 1;
  }

  [data-figures] dt {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  [data-figure-label] {
    color: var(--ink);
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
  }

  [data-figure-note] {
    color: var(--muted);
    font-size: var(--text-caption);
  }

  /* --- Reduced motion ----------------------------------------------------
   * No cross-fade. The autoplay is switched off in the script, which reads the
   * same query.
   */
  @media (prefers-reduced-motion: reduce) {
    [data-frame] {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Tab behaviour for the two frames.
   *
   * Autoplay exists so a visitor who never touches anything still sees the
   * point being made. It stops permanently at the first interaction — a demo
   * that keeps moving under someone's hand is worse than one that never moved.
   */
  const RESET = "manual";
  const CYCLE_MS = 4000;

  const section = document.querySelector<HTMLElement>("[data-voice-switch]");

  if (section) {
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panel = section.querySelector<HTMLElement>('[role="tabpanel"]');
    const frames = Array.from(section.querySelectorAll<HTMLElement>("[data-frame]"));
    const captions = Array.from(section.querySelectorAll<HTMLElement>("[data-caption-for]"));
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

    let userTookOver = false;
    let cycle: number | undefined;

    const show = (mode: string) => {
      for (const frame of frames) {
        frame.dataset.active = String(frame.dataset.frame === mode);
      }
      for (const caption of captions) {
        caption.hidden = caption.dataset.captionFor !== mode;
      }
      for (const tab of tabs) {
        const selected = tab.dataset.target === mode;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected) panel?.setAttribute("aria-labelledby", tab.id);
      }
      section.dataset.mode = mode;
    };

    const takeOver = () => {
      userTookOver = true;
      if (cycle !== undefined) window.clearInterval(cycle);
      cycle = undefined;
    };

    const startAutoplay = () => {
      if (userTookOver || calm.matches || cycle !== undefined) return;
      cycle = window.setInterval(() => {
        show(section.dataset.mode === RESET ? "jarvis" : RESET);
      }, CYCLE_MS);
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => {
        takeOver();
        show(tab.dataset.target ?? RESET);
      });

      /* The tab pattern owes arrow-key navigation; buttons alone do not give it. */
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        takeOver();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        show(next.dataset.target ?? RESET);
        next.focus();
      });
    }

    /* Nothing moves until the section is actually on screen. */
    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) startAutoplay();
          else if (cycle !== undefined) {
            window.clearInterval(cycle);
            cycle = undefined;
          }
        }
      },
      { threshold: 0.4 },
    ).observe(section);

    calm.addEventListener("change", () => {
      if (calm.matches) takeOver();
    });
  }
</script>
