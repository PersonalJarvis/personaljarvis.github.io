---
/**
 * The connection strip — every service Jarvis talks to, in one row.
 *
 * Layout follows the bar under the hero on the reference site, measured rather
 * than eyeballed: equal cells in a single row, 10px apart, no ornament beyond
 * a hairline. See docs/LOGOS.md.
 *
 * There are far more marks than cells, so each cell is a split-flap board, the
 * kind a station or a desk calendar uses. A card is cut across the middle. To
 * change it, the old top half falls forward and down about the seam, uncovering
 * the new top half that was lying flat underneath; then the new bottom half
 * drops from the seam onto the old one. Four layers, two of them moving.
 *
 * The whole thing is CSS — no JavaScript reaches the browser, and
 * `prefers-reduced-motion` gets a still frame instead of a special case.
 *
 * Sizes are rem throughout. The root font size scales with the viewport
 * (src/styles/layout.css), so a px height would freeze while everything around
 * it grew — which is exactly how this strip first read as too small.
 */
import Container from "@/components/Container.astro";
import { marks } from "@/components/logos/marks";

/** Cells in the row at the widest breakpoint, and marks stacked in each. */
const CELLS = 8;
const PER_CELL = 7;

/**
 * One card's turn: it swings down, holds, then falls away. The next card's
 * turn begins exactly where this one ends, so the three add up to the slot and
 * two cards are never mid-swing at the same time.
 */
const FOLD_IN_S = 0.75;
const HOLD_S = 3.5;
const FOLD_OUT_S = 0.75;
const SLOT_S = FOLD_IN_S + HOLD_S + FOLD_OUT_S;
const CYCLE_S = SLOT_S * PER_CELL;

/**
 * Every card's delay is negative, so each animation starts already in
 * progress: at the first paint one card per cell is resting mid-hold, instead
 * of the strip standing empty until the first one swings down.
 *
 * The offset carries a per-cell term as well as a per-card one. Without it all
 * eight cells fall on the same beat, which reads as a mechanism rather than a
 * board; a fraction of a slot apart, the fall ripples along the row.
 */
const cellOffset = (c: number) => (c * SLOT_S) / CELLS;
const startAt = (c: number, r: number) => -(r * SLOT_S + cellOffset(c) + SLOT_S / 2);

// The marks list is alphabetical, and the cells run nearly in phase, so a
// straight fill puts Slack, Spotify, Stripe and Supabase on screen together —
// which reads as a sorted directory rather than a set of partners. Walking the
// list in strides instead scatters neighbours apart. The stride is coprime
// with the list length, so it visits every mark exactly once, and it is fixed
// rather than random: the same build must produce the same strip.
const STRIDE = 23;
const pool = marks.map((_, i) => marks[(i * STRIDE) % marks.length]);

// Padding, because the grid holds a few more slots than there are marks.
//
// Which mark fills a spare slot matters. Padding from the start of the pool
// puts a copy about one slot away from its original in time, and a card is on
// screen for a whole slot, so both copies end up visible at once — two GitLabs
// side by side. Taking the filler from half a cycle back instead separates the
// pair by three slots, far wider than either is on screen for.
const PAD_BACK = Math.floor(PER_CELL / 2) * CELLS;
while (pool.length < CELLS * PER_CELL) pool.push(pool[pool.length - PAD_BACK]);

const columns = Array.from({ length: CELLS }, (_, c) =>
  Array.from({ length: PER_CELL }, (_, r) => pool[r * CELLS + c]),
);

/** Which cells survive at which width — the row never wraps. */
const visibility = [
  "",
  "",
  "",
  "hidden sm:block",
  "hidden lg:block",
  "hidden lg:block",
  "hidden 2xl:block",
  "hidden 2xl:block",
];
---

<section aria-labelledby="connects-label" class="py-20">
  <Container width="content">
    <p id="connects-label" class="eyebrow">Everything Jarvis connects</p>

    <ul
      class="mt-8 grid grid-cols-3 gap-[10px] sm:grid-cols-4 lg:grid-cols-6 2xl:grid-cols-8"
      style={`--cycle:${CYCLE_S}s; --slot:${SLOT_S}s`}
    >
      {
        columns.map((stack, c) => (
          <li
            class={`cell ${visibility[c]}`}
            style={`--cell-delay:${(-(cellOffset(c) + SLOT_S / 2)).toFixed(2)}s`}
          >
            {stack.map(({ name, Mark, rem }, r) => (
              <>
                <span
                  class="flap flap-top"
                  style={`--delay:${startAt(c, r).toFixed(2)}s; --mark:${rem}rem`}
                >
                  <Mark className="mark" />
                  <span class="sr-only">{name}</span>
                </span>
                <span
                  class="flap flap-bottom"
                  style={`--delay:${startAt(c, r).toFixed(2)}s; --mark:${rem}rem`}
                  aria-hidden="true"
                >
                  <Mark className="mark" />
                </span>
              </>
            ))}
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .eyebrow {
    text-align: center;
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
    color: var(--muted);
  }

  /*
   * The cell holds the space and supplies the depth; everything visible is a
   * flap inside it.
   */
  .cell {
    position: relative;
    height: 6.5rem;

    /*
     * Depth is what makes the flap read as falling towards the viewer rather
     * than being squashed. Too shallow (45rem) and the movement is ambiguous;
     * too strong (16rem) and the near edge grows by 60% and shoulders its way
     * out of the row.
     *
     * The perspective sits on the cell, not the row, so each card is viewed
     * square from its own centre. On the row it would fan the outer cards away
     * from the viewer like a book.
     */
    perspective: 24rem;

    /*
     * A flap swinging towards the viewer has to pass in front of its
     * neighbours, and z-index on the flap cannot do it: `perspective` makes the
     * cell a stacking context nothing inside can paint outside of. The cell is
     * lifted instead, for the moment its flaps are moving.
     */
    z-index: 1;
    animation: cell-front var(--slot) linear infinite;
    animation-delay: var(--cell-delay);
  }

  /*
   * The seam. On a real board it is the gap between the two halves, and it is
   * what tells the eye the card is split before anything moves.
   */
  .cell::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--canvas);
    z-index: 4;
    pointer-events: none;
  }

  @keyframes cell-front {
    0%,
    30% {
      z-index: 3;
    }
    30.01%,
    100% {
      z-index: 1;
    }
  }

  /*
   * Both halves of a mark are the same full card, clipped. Drawing the whole
   * mark in each and cutting it in half is what keeps the two halves in
   * register: any attempt to lay out a top half and a bottom half separately
   * drifts by a pixel and the seam stops lining up.
   */
  .flap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--ink);
    backface-visibility: hidden;
    animation-duration: var(--cycle);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: var(--delay);
  }

  .flap :global(.mark) {
    /*
     * One knob for the whole strip. Each mark carries its own optical height
     * (docs/LOGOS.md); this scales all of them together, so "the marks are too
     * small" is one number here rather than fifty in marks.ts.
     */
    height: calc(var(--mark) * 1.1);
    width: auto;
  }

  .flap-top {
    clip-path: inset(0 0 50% 0);
    transform-origin: center bottom;
    animation-name: flap-top;
  }

  .flap-bottom {
    clip-path: inset(50% 0 0 0);
    transform-origin: center top;
    animation-name: flap-bottom;
  }

  /*
   * The change takes 1.5s of a 5s slot, in two halves that must not overlap.
   *
   * First half: the OLD top falls forward and down about the seam, uncovering
   * the NEW top, which has been lying flat underneath it the whole time.
   * Second half: the NEW bottom, standing on edge towards the viewer, drops
   * onto the seam and covers the OLD bottom.
   *
   * Both rotations carry the moving edge towards the viewer — that is the
   * direction the whole thing turns on. Against the 35s cycle a slot is
   * 14.286% and each half of the change is 2.143%.
   */
  @keyframes flap-top {
    0% {
      transform: rotateX(0deg);
      opacity: 1;
      z-index: 1;
    }
    14.28% {
      transform: rotateX(0deg);
      opacity: 1;
      z-index: 3;
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.45);
    }
    16.42% {
      transform: rotateX(-90deg);
      opacity: 1;
      z-index: 3;
    }
    16.43% {
      opacity: 0;
      z-index: 0;
    }
    100% {
      opacity: 0;
      z-index: 0;
    }
  }

  @keyframes flap-bottom {
    0% {
      transform: rotateX(90deg);
      opacity: 1;
      z-index: 3;
    }
    2.14% {
      transform: rotateX(90deg);
      opacity: 1;
      z-index: 3;
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
    }
    4.28% {
      transform: rotateX(0deg);
      opacity: 1;
      z-index: 3;
    }
    4.29% {
      z-index: 1;
    }
    18.56% {
      transform: rotateX(0deg);
      opacity: 1;
      z-index: 1;
    }
    18.57% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /*
   * No motion: the board holds the first mark. Its two halves are the first
   * two flaps in the cell, so the seam still reads as a split card.
   */
  @media (prefers-reduced-motion: reduce) {
    .cell {
      animation: none;
    }
    .flap {
      animation: none;
      transform: none;
      opacity: 0;
    }
    .flap:nth-child(1),
    .flap:nth-child(2) {
      opacity: 1;
    }
  }
</style>
