---
/**
 * The connection strip — every service Jarvis talks to, in one row.
 *
 * Layout follows the bar under the hero on the reference site, measured rather
 * than eyeballed: equal cells in a single row, 10px apart, no ornament beyond
 * a hairline. See docs/LOGOS.md.
 *
 * There are far more marks than cells, so each cell cycles a stack of them. A
 * mark leaves by retreating into the depth of its card and dissolving; the
 * next arrives out of that same depth and settles onto the face. Both travel
 * the same way, so the pair reads as one movement through the card rather than
 * as two events on its surface.
 *
 * This replaced a split-flap, and the reason is worth keeping. The card was cut
 * across the middle and the top half fell forward about the seam. A real board
 * can do that because its seam, frame and shadow explain the cut. The seam was
 * deliberately left out here — it struck a line through every mark on a strip
 * that is mostly still — and without it the moving frames only ever showed a
 * mark sliced in half and offset, which reads as a rendering fault rather than
 * as a card turning over. A halved effect without its mechanism always does.
 *
 * The whole thing is CSS — no JavaScript reaches the browser, and
 * `prefers-reduced-motion` gets a still frame instead of a special case.
 *
 * Sizes are rem throughout. The root font size scales with the viewport
 * (src/styles/layout.css), so a px height would freeze while everything around
 * it grew — which is exactly how this strip first read as too small.
 */
import Container from "@/components/Container.astro";
import SectionTrack from "@/components/SectionTrack.astro";
import { marks } from "@/components/logos/marks";

/** Cells in the row at the widest breakpoint, and marks stacked in each. */
const CELLS = 8;
const PER_CELL = 7;

/**
 * One mark's turn: it arrives out of the depth, holds, then retreats back into
 * it. The outgoing mark begins leaving before the incoming one appears, so the
 * two overlap through the middle of the change and the card is never empty —
 * which is what keeps this reading as one movement instead of a cut.
 */
const RETREAT_S = 0.7;
const ARRIVE_DELAY_S = 0.5;
const ARRIVE_S = 0.8;
const CHANGE_S = ARRIVE_DELAY_S + ARRIVE_S;
const HOLD_S = 4.7;
const SLOT_S = CHANGE_S + HOLD_S;
const CYCLE_S = SLOT_S * PER_CELL;

/**
 * Every card's delay is negative, so each animation starts already in
 * progress: at the first paint one mark per cell is resting mid-hold, instead
 * of the strip standing empty until the first change comes round.
 *
 * The offset carries a per-cell term as well as a per-card one. Without it all
 * eight cells change on the same beat, which reads as a mechanism rather than
 * a board; a fraction of a slot apart, the change ripples along the row.
 */
const cellOffset = (c: number) => (c * SLOT_S) / CELLS;
const startAt = (c: number, r: number) => -(r * SLOT_S + cellOffset(c) + SLOT_S / 2);

// The marks list is alphabetical, and the cells run nearly in phase, so a
// straight fill puts Slack, Spotify, Stripe and Supabase on screen together —
// which reads as a sorted directory rather than a set of partners. Walking the
// list in strides instead scatters neighbours apart. The stride is coprime
// with the list length, so it visits every mark exactly once, and it is fixed
// rather than random: the same build must produce the same strip.
const STRIDE = 23;
const pool = marks.map((_, i) => marks[(i * STRIDE) % marks.length]);

// Padding, because the grid holds a few more slots than there are marks.
//
// Which mark fills a spare slot matters. Padding from the start of the pool
// puts a copy about one slot away from its original in time, and a card is on
// screen for a whole slot, so both copies end up visible at once — two GitLabs
// side by side. Taking the filler from half a cycle back instead separates the
// pair by three slots, far wider than either is on screen for.
const PAD_BACK = Math.floor(PER_CELL / 2) * CELLS;
while (pool.length < CELLS * PER_CELL) pool.push(pool[pool.length - PAD_BACK]);

const columns = Array.from({ length: CELLS }, (_, c) =>
  Array.from({ length: PER_CELL }, (_, r) => pool[r * CELLS + c]),
);

/** Which cells survive at which width — the row never wraps. */
const visibility = [
  "",
  "",
  "",
  "hidden sm:block",
  "hidden lg:block",
  "hidden lg:block",
  "hidden 2xl:block",
  "hidden 2xl:block",
];
---

<section aria-labelledby="connects-label" class="relative">
  <SectionTrack />
  <Container width="content">
    <!--
      The rule that separates this strip from the hero above it. It sits
      INSIDE the container, so it starts and ends exactly on the two rails
      instead of overshooting them by a gutter a side. The section's own
      vertical padding moved onto it for the same reason every other section
      does it: the line has to mark the boundary, not float below it.
    -->
    <div class="section-rule py-20">
      <p id="connects-label" class="eyebrow">Everything Jarvis connects</p>

      <ul
        class="mt-8 grid grid-cols-3 gap-[10px] sm:grid-cols-4 lg:grid-cols-6 2xl:grid-cols-8"
        style={`--cycle:${CYCLE_S}s`}
      >
        {
          columns.map((stack, c) => (
            <li class={`cell ${visibility[c]}`}>
              {stack.map(({ name, Mark, rem }, r) => (
                <span
                  class="surface"
                  style={`--delay:${startAt(c, r).toFixed(2)}s; --mark:${rem}rem`}
                >
                  <Mark className="mark" />
                  <span class="sr-only">{name}</span>
                </span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  .eyebrow {
    text-align: center;
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
    color: var(--muted);
  }

  /*
   * The cell holds the space; everything visible is a surface inside it.
   *
   * It deliberately establishes NO stacking context — no `perspective`, no
   * `z-index`, no `transform`. An arriving card is briefly larger than its
   * cell and overlaps its neighbours, and a context here would trap it inside
   * the cell so it passed behind them instead. The surfaces order themselves
   * across the whole row instead, which is something the split-flap could not
   * do: its `perspective` forced a per-cell context, and the cell itself had
   * to be lifted for the moment its flaps were moving.
   */
  .cell {
    position: relative;
    height: 6.5rem;
  }

  .surface {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--ink);
    animation: surface var(--cycle) linear infinite;
    animation-delay: var(--delay);
  }

  .surface :global(.mark) {
    /*
     * One knob for the whole strip. Each mark carries its own optical height
     * (docs/LOGOS.md); this scales all of them together, so "the marks are too
     * small" is one number here rather than fifty in marks.ts.
     */
    height: calc(var(--mark) * 1.1);
    width: auto;
  }

  /*
   * The change takes 1.3s of a 6s slot, and the whole card travels — border
   * and ground included, not just the mark — so it reads as the card moving
   * through the strip rather than as its contents being swapped out.
   *
   * Against the 42s cycle a slot is 14.286%. The outgoing mark's retreat is
   * 1.667%; the incoming one waits 1.190% before its own 1.905%, so the two
   * overlap for the middle 0.476% of the change.
   *
   * The arriving card is scaled ABOVE 1 and comes back down to it, so it
   * enters from in front of the page and settles, rather than growing into
   * place from behind. It carries `z-index: 2` while it does, which is what
   * puts it over the card it is replacing and over its neighbours.
   */
  @keyframes surface {
    0% {
      transform: scale(1.18);
      opacity: 0;
      z-index: 2;
    }
    1.19% {
      transform: scale(1.18);
      opacity: 0;
      z-index: 2;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.3, 1);
    }
    3.1% {
      transform: scale(1);
      opacity: 1;
      z-index: 2;
    }
    3.11% {
      z-index: 1;
    }
    14.29% {
      transform: scale(1);
      opacity: 1;
      z-index: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.9, 0.5);
    }
    15.95% {
      transform: scale(0.82);
      opacity: 0;
      z-index: 1;
    }
    100% {
      transform: scale(0.82);
      opacity: 0;
      z-index: 1;
    }
  }

  /*
   * No motion: the board holds the first mark of each cell, at rest.
   */
  @media (prefers-reduced-motion: reduce) {
    .surface {
      animation: none;
      transform: none;
      opacity: 0;
    }
    .surface:first-child {
      opacity: 1;
    }
  }
</style>
