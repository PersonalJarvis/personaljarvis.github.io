---
import { OS_SIGNATURES, UNSUPPORTED_OS } from "@/lib/install";
---
<script is:inline define:vars={{ signatures: OS_SIGNATURES, unsupported: UNSUPPORTED_OS }}>
  (() => {
    const ua = navigator.userAgent || "";
    const mobile = new RegExp(unsupported, "i").test(ua) || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
    const match = mobile ? null : signatures.find(([, pattern]) => new RegExp(pattern, "i").test(ua));
    document.documentElement.dataset.os = match?.[0] || "unknown";
    document.documentElement.dataset.downloadLanguage = navigator.language.startsWith("de") ? "de" : "en";
  })();
</script>
