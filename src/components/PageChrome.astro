---
/**
 * Page chrome — the two rails.
 *
 * Rendered ONCE, in the root layout. Never per section: a rail assembled from
 * one segment per section is a rail with seams, and the seams are the first
 * thing the eye finds on a long page.
 *
 * The rails stand on the edges of the `content` step and get there through the
 * Container itself rather than a recomputed pixel value, so they cannot drift
 * from the width formula. Everything else — the layer they sit in and the
 * breakpoint below which they disappear — is in src/styles/layout.css next to
 * that formula.
 *
 * THERE IS NO MARKER HERE ANY MORE. A single square walking the whole document
 * used to ride the left rail from this file. It was replaced on 2026-08-29 by a
 * marker per section — SectionTrack.astro — which walks the section's own
 * perimeter and says both how far the reader is through THIS section and how
 * much of it is left. Two indicators on the same rail disagreeing about what
 * "how far" means is worse than either alone, so this one went. See
 * docs/layout.md § "The section marker".
 *
 * Decorative only: aria-hidden, pointer-events: none, no navigation function.
 */
import Container from "@/components/Container.astro";
---

<div class="page-chrome" aria-hidden="true">
  <Container width="content" class="page-chrome__column">
    <div class="page-chrome__rails"></div>
  </Container>
</div>
