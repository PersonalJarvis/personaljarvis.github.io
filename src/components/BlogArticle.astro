---
/**
 * The frame every blog post shares: the site's chrome, a header on the
 * `prose` step, an optional media slot on the `content` step, the body back on
 * `prose`, a closing install block, and the footer.
 *
 * Why the media slot is its own width: docs/layout.md puts text on `prose` and
 * pictures on `content`. A launch video squeezed into the reading column is a
 * thumbnail; the same video at `content` width is the thing the post is about.
 *
 * The closing block carries `id="install"` because the nav's Download button
 * points at `#install` on every route. On a post that id has to exist, or the
 * one primary action in the nav scrolls nowhere.
 *
 * Typography follows LegalPage.astro: `display-xl` on the h1 because a page
 * with no hero spends it there (docs/design.md § Typography).
 */
import Base from "@/layouts/Base.astro";
import Container from "@/components/Container.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import Legal from "@/sections/Legal.astro";
import { BLOG_HREF, blogPost, formatPostDate } from "@/lib/blog";

interface Props {
  /** The post's entry in `src/lib/blog.ts`. */
  slug: string;
}

const post = blogPost(Astro.props.slug);
const socialImage = new URL(post.socialImage, Astro.site).href;
const hasMedia = Astro.slots.has("media");
---

<Base title={`${post.title} — Personal Jarvis`} description={post.description}>
  <Fragment slot="head">
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={post.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta property="article:published_time" content={post.published} />
  </Fragment>

  <main class="relative">
    <Container width="prose">
      <header class="post-head">
        <p class="post-kicker">
          <a href={BLOG_HREF}>Blog</a>
          <span aria-hidden="true">·</span>
          <time datetime={post.published}>{formatPostDate(post.published)}</time>
        </p>
        <h1>{post.title}</h1>
        {Astro.slots.has("lede") && <p class="post-lede"><slot name="lede" /></p>}
      </header>
    </Container>

    {
      hasMedia && (
        <Container width="content" class="post-media">
          <slot name="media" />
        </Container>
      )
    }

    <Container width="prose">
      <article class="post-body">
        <slot />
      </article>
    </Container>

    {/*
      The divider sits on an element INSIDE the container, never on the
      section: a border on the section spans the whole window and runs out
      through both rails (docs/layout.md § "Horizontal rules").
    */}
    <section id="install" class="post-install">
      <Container width="prose">
        <div class="post-install__inner">
          <h2>Try it on your own machine</h2>
          <p class="post-install__lede">
            Personal Jarvis is free and open source. One line installs it on
            Windows, macOS or Linux.
          </p>
          <InstallCommand />
          <p class="post-install__back">
            <a href={BLOG_HREF}>All posts</a>
          </p>
        </div>
      </Container>
    </section>
  </main>
  <Legal />
</Base>

<style>
  .post-head {
    padding-block: calc(var(--nav-height) + 3rem) 2.5rem;
  }

  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--muted);
    font-size: var(--text-caption-upper);
    font-weight: 600;
    letter-spacing: var(--tracking-caption-upper);
    text-transform: uppercase;
  }

  .post-kicker a {
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-kicker a:hover,
  .post-kicker a:focus-visible {
    color: var(--ink);
  }

  .post-head h1 {
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(2.25rem, 1.6rem + 2vw, var(--text-display-xl));
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: var(--tracking-display-xl);
    text-wrap: balance;
  }

  .post-lede {
    margin-top: 1.5rem;
    color: var(--body);
    font-size: var(--text-title-md);
    line-height: 1.55;
  }

  .post-media {
    padding-bottom: 1rem;
  }

  .post-body {
    padding-block: 2rem 4rem;
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .post-body > :global(:first-child) {
    margin-top: 0;
  }

  .post-body :global(h2) {
    margin-top: 3.5rem;
    color: var(--ink);
    font-size: var(--text-display-md);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: var(--tracking-display-md);
  }

  .post-body :global(h3) {
    margin-top: 2rem;
    color: var(--ink);
    font-size: var(--text-title-md);
    font-weight: 600;
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: 1rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.25rem;
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li + li) {
    margin-top: 0.5rem;
  }

  .post-body :global(li::marker) {
    color: var(--muted);
  }

  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .post-body :global(kbd) {
    display: inline-block;
    min-width: 1.6em;
    padding: 0.05em 0.4em;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    background: var(--surface-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.4;
    text-align: center;
  }

  .post-install {
    padding-bottom: var(--space-section);
  }

  .post-install__inner {
    padding-top: 3rem;
    border-top: 1px solid var(--hairline);
  }

  .post-install h2 {
    color: var(--ink);
    font-size: var(--text-display-md);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: var(--tracking-display-md);
  }

  .post-install__lede {
    margin-block: 0.75rem 1.5rem;
    color: var(--body);
  }

  .post-install__back {
    margin-top: 2rem;
    font-size: var(--text-body-sm);
  }

  .post-install__back a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-kicker a {
      transition: none;
    }
  }
</style>
