---
/**
 * One glyph per trigger kind, the way the application draws them on a skill row.
 *
 * A microphone for a spoken phrase, a keyboard for a chord, a clock for a cron
 * line — and one glyph PER TRIGGER rather than per kind, so a skill with two
 * spoken phrases shows two microphones. That is the app's own behaviour and it
 * is worth keeping: it says at a glance how many ways there are into a skill.
 *
 * Drawn inline rather than pulled from an icon set. Three shapes at 14px do not
 * justify a dependency, and an inline `currentColor` stroke follows the row's
 * ink without a second asset.
 */
import type { TriggerType } from "@/lib/catalog";

interface Props {
  type: TriggerType;
  /** What a screen reader hears. Absent leaves the glyph decorative, which is
   *  right when a label beside it already says the same thing. */
  label?: string;
}

const { type, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="14"
  height="14"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    type === "voice" && (
      <>
        <rect x="9" y="2" width="6" height="11" rx="3" />
        <path d="M5 11a7 7 0 0 0 14 0M12 18v4" />
      </>
    )
  }
  {
    type === "hotkey" && (
      <>
        <rect x="2" y="6" width="20" height="12" rx="2" />
        <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8" />
      </>
    )
  }
  {
    type === "schedule" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
</svg>
