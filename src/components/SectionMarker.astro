---
/**
 * The square itself — ONE element for the whole page, in a fixed layer.
 *
 * `SectionTrack` says where each section's perimeter is. This file owns the
 * single square that walks all of them, and the schedule that decides which
 * perimeter it is on at any scroll position. Rendered once, from `Base.astro`,
 * beside `PageChrome` and for the same reason: what runs the length of the
 * document is not any one section's to draw.
 *
 * WHY THE SQUARE LEFT THE SECTIONS. It used to be one element per section, with
 * `visibility` revealing whichever section the reader was inside. Three things
 * came out of that and all three were reported as bugs on 2026-08-29:
 *
 *   it disappeared   A pinned section's square is drawn in the frame but timed
 *                    by the tall track behind it. The track kept the square for
 *                    a viewport after the frame had scrolled off the top, so
 *                    there was no square at all over the first screen of
 *                    `This is being built in public`, and again after the
 *                    stargazers globe and the install steps.
 *   it was clipped   The square overhangs its own corners by half its width,
 *                    and it sat inside boxes that hide their overflow.
 *   it could not     Twelve `getBoundingClientRect` calls a frame, to answer a
 *   keep up          question that only changes when the page is resized.
 *
 * A fixed layer has none of those: nothing clips it, there is one transform to
 * write, and the section it belongs to is a comparison against numbers worked
 * out once. See docs/layout.md § "The section marker".
 *
 * Decorative: aria-hidden, pointer-events: none, no navigation function. Its
 * CSS is in src/styles/layout.css, next to the width formula the rails are
 * measured against.
 */
---

<div class="section-marker" aria-hidden="true">
  <span class="section-marker__dot"></span>
</div>

<script>
  import {
    READING_SHARE,
    scheduleTracks,
    sidesForTracks,
    trackPath,
    type TrackEnd,
    type TrackMeasure,
    type TrackSpan,
  } from "@/lib/sectionTrack";

  /* Half the 8px square: the transform places its top-left corner, and every
   * point on the path is where the square's CENTRE has to be. */
  const HALF = 4;

  const dot = document.querySelector<HTMLElement>(".section-marker__dot");
  const layers = Array.from(document.querySelectorAll<HTMLElement>("[data-section-track]"));

  if (dot && layers.length > 0) {
    /* The serpentine, folded over document order — the only place that order is
     * knowable, since a component cannot see its own siblings.
     *
     * EVERY JOINT ON THIS PAGE CARRIES A LINE, so every section turns the
     * corner and the sides simply alternate. `open` no longer means "hands over
     * without crossing"; it means "the line at my bottom joint is drawn by the
     * section BELOW me" — see `TrackMeasure.cross`. The fold is still done by
     * `sidesForTracks` rather than by `index % 2`, because the day a joint
     * really draws nothing, the chain has to keep the side rather than flip it,
     * and that is the one rule that holds for both cases. */
    const sides = sidesForTracks(layers.map((): TrackEnd => "closed"));

    const tracks = layers.map((layer, index) => {
      const box = layer.querySelector<HTMLElement>(".section-track__box")!;
      const path = layer.querySelector<SVGPathElement>("path")!;
      /* Written before getTotalLength reads it. */
      path.setAttribute("d", trackPath(sides[index], "closed"));
      return {
        box,
        path,
        side: sides[index],
        /* Whether this section's own bottom edge is the drawn line at its
         * bottom joint, or the section below draws it. */
        end: layer.dataset.sectionTrack === "open" ? "open" : ("closed" as TrackEnd),
        /* The tall track a pinned section scrolls on, if it has one. Whether it
         * is actually pinning is decided per measurement, not here. */
        pin: layer.closest<HTMLElement>("[data-scroll-span]"),
        length: path.getTotalLength(),
      };
    });

    /**
     * WHICH element is actually held still, right now — or null.
     *
     * `[data-scroll-span]` is markup and says the section CAN pin. Whether it
     * DOES is a computed style: `Install` drops its own pin whenever the frame
     * is too short for four steps, and `VoiceSwitch` and the stargazers drop
     * theirs below their breakpoints. Ask the elements, and every one of those
     * cases is answered without this file knowing any of them.
     *
     * It returns the element rather than a boolean because the schedule needs
     * two numbers off it — where it rests and how tall it is — and they are
     * not the window's any more. See `TrackMeasure.pinRest`.
     */
    const stickyChild = (box: HTMLElement, pin: HTMLElement | null) => {
      if (!pin) return null;
      for (let el: HTMLElement | null = box; el && el !== pin; el = el.parentElement) {
        if (getComputedStyle(el).position === "sticky") return el;
      }
      return getComputedStyle(pin).position === "sticky" ? pin : null;
    };

    let spans: TrackSpan[] = [];
    let stale = true;

    /* Everything that forces layout happens HERE, and here runs on a resize, on
     * load and when a tracked element changes size — never on a scroll. */
    const measure = () => {
      stale = false;
      const viewport = window.innerHeight;
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - viewport);
      const top = window.scrollY;

      const boxes = tracks.map((track) => {
        track.length = track.path.getTotalLength();
        const boxRect = track.box.getBoundingClientRect();
        const sticky = stickyChild(track.box, track.pin);
        const pinRect = sticky ? track.pin!.getBoundingClientRect() : null;
        /* Where it comes to REST, off the style, not where it happens to be
         * this frame: the rect only reads that back while the pin is
         * actually holding, and the schedule is worked out once for every
         * scroll position at which it will. */
        const rest = sticky ? parseFloat(getComputedStyle(sticky).top) || 0 : 0;
        return {
          boxTop: boxRect.top + top,
          boxHeight: boxRect.height,
          pinTop: pinRect ? pinRect.top + top : null,
          pinHeight: pinRect ? pinRect.height : 0,
          pinRest: rest,
          pinBox: sticky ? sticky.getBoundingClientRect().height : 0,
        };
      });

      /**
       * Where the line at a section's bottom joint is, in the document.
       *
       * A PINNED NEIGHBOUR'S OPENING RULE IS NOT WHERE ITS BOX CURRENTLY IS.
       * Its box is a sticky child, so a rect taken while the pin is holding
       * reads back the resting place rather than the layout position, and the
       * schedule has to be true at every scroll position — including the ones
       * measured from somewhere else on the page. Its track never moves, and
       * the child rests one `pinRest` inside it, so those two say where the
       * reader will see that rule when the square arrives at it.
       */
      const openingRule = (i: number) => {
        const at = boxes[i];
        if (!at) return null;
        return at.pinTop === null ? at.boxTop : at.pinTop + at.pinRest;
      };

      spans = scheduleTracks(
        tracks.map((track, i): TrackMeasure => {
          const at = boxes[i];
          return {
            ...at,
            end: track.end,
            /* Its own closing rule, or — when it draws none — the opening rule
             * of the section below, which is the line the reader actually sees
             * at that joint. */
            cross: track.end === "closed" ? at.boxTop + at.boxHeight : openingRule(i + 1),
          };
        }),
        viewport,
        maxScroll,
      );
    };

    /** Which section owns the square: the last one the reader has entered. */
    const ownerAt = (top: number) => {
      let owner = 0;
      for (let i = 0; i < spans.length; i++) {
        if (top >= spans[i].enter) owner = i;
      }
      return owner;
    };

    /**
     * A point on one section's perimeter, in VIEWPORT pixels.
     *
     * The rails and the rules are 1px lines lying just inside the tracked box —
     * on its left and right, and just below it at the bottom — so the square is
     * centred on the line rather than on the box's edge. Both corrections are
     * linear in the point's own coordinate, which is what makes them one term
     * each instead of a case per corner: the x nudge runs +0.5 to -0.5 across
     * the box, the y nudge is +0.5 everywhere. Drop them and the square sits a
     * pixel off the line it is meant to ride, which is visible.
     */
    const pointOn = (track: (typeof tracks)[number], progress: number) => {
      const along = Math.min(1, Math.max(0, progress));
      const point = track.path.getPointAtLength(along * track.length);
      const rect = track.box.getBoundingClientRect();
      return {
        x: rect.left + (point.x / 100) * rect.width + 0.5 - point.x / 100,
        y: rect.top + (point.y / 100) * rect.height + 0.5,
      };
    };

    /** This section's two rails, in viewport pixels, entry side first. */
    const railsOf = (track: (typeof tracks)[number]) => {
      const rect = track.box.getBoundingClientRect();
      /* The rails are 1px lines lying just INSIDE the box, so the square is
       * centred on the line rather than on the box's edge. */
      const left = rect.left + 0.5;
      const right = rect.right - 0.5;
      return track.side === "left" ? { entry: left, exit: right } : { entry: right, exit: left };
    };

    /**
     * A FLOWING section: down the rail, across the rule, and that is all.
     *
     * TWO STRETCHES, NOT THREE, and the reader sees them as one line:
     *
     *   down the rail   the whole of the section up to its corner. The square
     *                   drifts from the top of the band to the bottom of it over
     *                   ALL of that scrolling, which on an ordinary section is
     *                   half a pixel of screen per pixel of scroll — slow enough
     *                   that it reads as holding the reader's height
     *   across the rule the corner. The square is ON the rule and stays on it,
     *                   so it rises exactly as fast as the reader scrolls, and
     *                   it lands on the far rail at the top of the band — which
     *                   is where the section below picks it up
     *
     * IT USED TO HAVE A THIRD, and that third was the defect. The square held a
     * fixed line and then dropped onto the rule in one short lunge just before
     * the corner, which read as it lifting off the line and tipping over; and
     * because the lunge and the crossing shared one small budget, the crossing
     * itself was a whole column width in a single wheel notch. Spreading the
     * same drop over the whole section costs a tenth of the speed and buys the
     * corner four times the scrolling.
     */
    const onTheLine = (
      track: (typeof tracks)[number],
      span: TrackSpan,
      top: number,
    ) => {
      const reading = window.innerHeight * READING_SHARE;
      const rails = railsOf(track);
      /* The top of the band, which is where every section takes the square and
       * where every section leaves it. */
      const rides = reading - span.crossing / 2;

      if (span.cross === null) return { x: rails.entry, y: rides + 0.5 };

      /* Never above the band: past its own rule a section is done and the
       * hand-over has the square, but the last one on the page has nothing to
       * hand to and simply holds. */
      const rule = Math.max(rides, span.cross - top);

      if (rule >= rides + span.crossing) {
        const rail = span.leave - span.crossing - span.enter;
        const down = rail > 0 ? Math.min(1, Math.max(0, (top - span.enter) / rail)) : 1;
        return { x: rails.entry, y: rides + span.crossing * down + 0.5 };
      }

      const across = (rides + span.crossing - rule) / span.crossing;
      return { x: rails.entry + (rails.exit - rails.entry) * across, y: rule + 0.5 };
    };

    /** Where a section takes the square, and where it leaves it. */
    const startOf = (i: number) =>
      spans[i].pinned ? pointOn(tracks[i], 0) : onTheLine(tracks[i], spans[i], spans[i].enter);

    const endOf = (i: number, top: number) =>
      spans[i].pinned ? pointOn(tracks[i], 1) : onTheLine(tracks[i], spans[i], top);

    const place = (top: number) => {
      const index = ownerAt(top);
      const span = spans[index];
      const next = spans[index + 1];

      let point;
      if (top <= span.leave || !next) {
        /* A PINNED SECTION IS THE OTHER SHAPE and it is left exactly as it was:
         * the page stands still under the reader, so the square walks the
         * frame's whole perimeter over the scrolling the pin costs. That is the
         * one the maintainer signed off on. */
        point = span.pinned
          ? pointOn(tracks[index], (top - span.enter) / Math.max(1, span.leave - span.enter))
          : onTheLine(tracks[index], span, top);
      } else {
        /* THE GAP: dead scrolling that belongs to no section's box, and the
         * square glides across it from where this section left it to where the
         * next one takes it. Between two ordinary sections those two are the
         * same rail and, unless their bands differ in height, the same point —
         * so there is usually nothing at all to see. Where one of the two is
         * PINNED there is: its end of the joint is a corner of a frame rather
         * than a point in the band, and the glide is what keeps the square on
         * screen while that frame is arriving or leaving. */
        const gap = span.hand - span.leave;
        const across = gap > 0 ? Math.min(1, (top - span.leave) / gap) : 1;
        const from = endOf(index, top);
        const to = startOf(index + 1);
        point = {
          x: from.x + (to.x - from.x) * across,
          y: from.y + (to.y - from.y) * across,
        };
      }

      dot.style.transform = `translate3d(${point.x - HALF}px, ${point.y - HALF}px, 0)`;
    };

    let frame = 0;
    let placed = -1;

    const loop = () => {
      frame = requestAnimationFrame(loop);
      if (stale) {
        measure();
        placed = -1;
      }
      const top = window.scrollY;
      /* Nothing that decides the square's position changes without the page
       * scrolling or the layout going stale, so a still page costs one number
       * comparison a frame and nothing else. */
      if (top === placed) return;
      placed = top;
      place(top);
      dot.style.visibility = "visible";
    };

    const invalidate = () => {
      stale = true;
    };

    addEventListener("resize", invalidate, { passive: true });
    /* The pinned sections decide whether they pin on `load`, once their images
     * and islands have settled, and that changes a track from four screens to
     * one. */
    addEventListener("load", invalidate, { passive: true });

    if ("ResizeObserver" in window) {
      /* The tracked elements, for a section that grows — and the body, because
       * a section growing ABOVE this one moves it down the document without
       * changing its own size. */
      const grown = new ResizeObserver(invalidate);
      for (const track of tracks) {
        grown.observe(track.box);
        if (track.pin) grown.observe(track.pin);
      }
      grown.observe(document.body);
    }

    frame = requestAnimationFrame(loop);
    addEventListener("pagehide", () => cancelAnimationFrame(frame), { once: true });
  }
</script>
