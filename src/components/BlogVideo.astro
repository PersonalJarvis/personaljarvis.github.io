---
/**
 * A self-hosted video inside a blog post, with a still until play.
 *
 * Self-hosted rather than embedded: a third-party player contacts its owner as
 * soon as the page loads, and the footer promises YouTube is contacted only
 * when a reader presses play. A plain `<video>` on this domain keeps the page
 * inside that promise with no facade to maintain.
 *
 * `preload="metadata"` fetches the header and the duration only — the file is
 * encoded with its index at the front (`-movflags +faststart`), so that is a
 * few kilobytes, not the video. Nothing plays by itself, and the sound stays
 * the reader's choice.
 */
interface Props {
  src: string;
  poster: string;
  /** What the video shows, for readers who cannot watch it. */
  label: string;
  /** Pixel size of the file, so the box holds its shape before it loads. */
  width: number;
  height: number;
  caption?: string;
}

const { src, poster, label, width, height, caption } = Astro.props;
---

<figure class="blog-video">
  <video
    controls
    playsinline
    preload="metadata"
    poster={poster}
    width={width}
    height={height}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    <a href={src}>Download the video</a>
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    /* `--rule`, not a hairline: a post puts the video on the `content` step, so
       its left and right edges stand on the two rails and are the same line
       (docs/layout.md § "Blocks that cross a rail"). */
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .blog-video figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--text-caption);
  }
</style>
