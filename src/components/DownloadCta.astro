---
/**
 * The download button — hands the visitor the installer for their machine.
 *
 * HISTORY. Until 2026-09-01 it read "Download for Windows" on every screen.
 * Then it named the visitor's machine but only scrolled to the install
 * command. Since 2026-10-01 it downloads the native installer directly: a
 * `.dmg` on a Mac, the setup `.exe` on Windows, the AppImage on Linux. The
 * command-line install is still on the page, further down (`#install`).
 *
 * ONE ANCHOR PER INSTALLER, CHOSEN BY CSS. `OsProbe.astro` writes
 * `data-download` on <html> from the head, before the body is parsed, and the
 * rules below reveal the one anchor that matches. An `href` cannot be swapped
 * by CSS, so every installer gets an anchor of its own, and the four that are
 * not shown are `display: none` — out of the accessibility tree as well, so a
 * screen reader announces one link with one name.
 *
 * WITHOUT JAVASCRIPT, OR ON A MACHINE WITH NO INSTALLER (a phone, a
 * Chromebook, ARM Linux), the `other` anchor stands: a plain "Download" that
 * opens the release page, which lists every package. It never offers an
 * installer the machine cannot run.
 *
 * MAC ARCHITECTURE. The user agent cannot tell Apple silicon from Intel, so
 * every Mac starts on Apple silicon. Chromium can say more, asynchronously;
 * the script below asks and corrects the attribute. Everyone else sees the
 * other build named under the hero button (`DownloadNote.astro`).
 *
 * A LINK AND NOT A BUTTON, because it navigates. Middle-click and "copy link
 * address" keep working, and the address is the stable
 * `releases/latest/download/<name>` one — see `src/lib/install.ts`.
 */
import { DOWNLOAD_TARGETS, DEFAULT_DOWNLOAD, installerLabelFor } from "@/lib/install";

interface Props {
  /**
   * How the caller dresses it. The hero wants the pill from docs/hero.md; the
   * nav wants its own `site-nav__cta`. This component owns the words and the
   * destination, never the looks.
   */
  class?: string;
  /**
   * Say only "Download". The nav row is width-constrained to the character
   * (src/lib/nav.ts); the destination is still the visitor's own installer.
   */
  bare?: boolean;
}

const { class: className, bare = false } = Astro.props;
---

{
  DOWNLOAD_TARGETS.map((target) => (
    <a
      href={target.href}
      class:list={["download-cta", className]}
      data-download-for={target.id}
      data-fallback={target.id === DEFAULT_DOWNLOAD ? "" : undefined}
    >
      {bare ? "Download" : installerLabelFor(target.id)}
    </a>
  ))
}

<style>
  /* Hidden by default; exactly one rule below puts one back. An unknown
     `data-download` value therefore shows none rather than two. */
  .download-cta {
    display: none;
  }

  /* One line per installer, because CSS cannot compare an attribute on <html>
     with one on a descendant. A new installer means a new line here and a new
     entry in DOWNLOAD_TARGETS, in the same edit — the dist test checks it.

     `:global()` on the <html> half is required: the element is outside this
     component, so Astro's scoping must not narrow it. */
  :global(html[data-download="macos-arm64"]) .download-cta[data-download-for="macos-arm64"],
  :global(html[data-download="macos-x64"]) .download-cta[data-download-for="macos-x64"],
  :global(html[data-download="windows"]) .download-cta[data-download-for="windows"],
  :global(html[data-download="linux"]) .download-cta[data-download-for="linux"],
  :global(html[data-download="other"]) .download-cta[data-download-for="other"],
  :global(html:not([data-download])) .download-cta[data-fallback] {
    display: inline-flex;
  }
</style>

<script>
  import { refineMacArchitecture, type DownloadId } from "@/lib/install";

  /*
   * Chromium only: ask for the CPU architecture and move an Intel Mac onto the
   * Intel build. Asynchronous, so it cannot live in the head probe — by the
   * time it answers the page is painted, and on an Apple silicon Mac (the
   * common case) nothing changes. Any failure keeps the first guess, which the
   * note under the hero button lets the visitor correct by hand.
   */
  interface UserAgentData {
    getHighEntropyValues(hints: string[]): Promise<{ architecture?: string }>;
  }

  const root = document.documentElement;
  const current = root.getAttribute("data-download") as DownloadId | null;
  const uaData = (navigator as Navigator & { userAgentData?: UserAgentData }).userAgentData;

  if (current?.startsWith("macos") && uaData?.getHighEntropyValues) {
    uaData
      .getHighEntropyValues(["architecture"])
      .then(({ architecture }) => {
        root.setAttribute("data-download", refineMacArchitecture(current, architecture));
      })
      .catch(() => {
        /* Refused or unsupported: the first guess stands, and the hero note
           offers the other Mac build, so there is nothing to report. */
      });
  }
</script>
