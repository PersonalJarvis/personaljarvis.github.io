---
import { INSTALL_TARGETS, downloadLabelFor } from "@/lib/install";
import { INSTALL_ID } from "@/lib/nav";
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<a href={`#${INSTALL_ID}`} class:list={["download-cta", className]} data-download-cta>
  {INSTALL_TARGETS.map((target) => (
    <span class="download-cta__label" data-os={target.id}>
      <span class="download-cta__en">{downloadLabelFor(target.id)}</span>
      <span class="download-cta__de" lang="de">{downloadLabelFor(target.id, "de")}</span>
    </span>
  ))}
  <span class="download-cta__fallback">Choose a download</span>
</a>
<script>
  import { initializeDownloads } from "@/lib/downloads";
  initializeDownloads();
</script>
<style>
  .download-cta__label, .download-cta__de { display: none; }
  :global(html[data-os="windows"]) .download-cta__label[data-os="windows"],
  :global(html[data-os="macos"]) .download-cta__label[data-os="macos"],
  :global(html[data-os="linux"]) .download-cta__label[data-os="linux"] { display: inline; }
  :global(html:is([data-os="windows"], [data-os="macos"], [data-os="linux"])) .download-cta__fallback { display: none; }
  :global(html[data-download-language="de"]) .download-cta__en { display: none; }
  :global(html[data-download-language="de"]) .download-cta__de { display: inline; }
</style>
