---
/**
 * The page shell. Every route extends this one.
 *
 * It owns <head>, the stylesheet and the page chrome, and nothing else —
 * layout belongs to Container (docs/layout.md), looks belong to the tokens
 * (docs/design.md).
 *
 * PageChrome is here rather than in a section because the rails run the whole
 * page. Assembled per section they would come out as segments with seams, and
 * the seams are the first thing the eye finds. See docs/layout.md.
 *
 * SectionMarker is here for the same reason. There is exactly one square on the
 * page and it walks every section's perimeter in turn, so it belongs to the
 * document rather than to any one section — which is also what lets it cross
 * the gaps BETWEEN sections instead of parking in a corner until the next one
 * starts. The sections declare their own geometry with `SectionTrack`.
 *
 * SiteNav is here for the same class of reason. It used to be markup inside
 * `Hero.astro`, pinned with `sticky` — and sticky pins a child only for as long
 * as its own parent is on screen, so the nav slid away at the hero's bottom
 * edge and the other ten sections had none at all. A nav that belongs to the
 * whole document has to be rendered by the thing that owns the whole document.
 */
import PageChrome from "@/components/PageChrome.astro";
import SectionMarker from "@/components/SectionMarker.astro";
import SiteNav from "@/components/SiteNav.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <PageChrome />
    <SectionMarker />
    <SiteNav />
    <slot />
  </body>
</html>
