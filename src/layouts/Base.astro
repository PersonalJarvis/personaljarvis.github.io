---
/**
 * The page shell. Every route extends this one.
 *
 * It owns <head>, the stylesheet and the page chrome, and nothing else —
 * layout belongs to Container (docs/layout.md), looks belong to the tokens
 * (docs/design.md).
 *
 * PageChrome is here rather than in a section because the rails run the whole
 * page. Assembled per section they would come out as segments with seams, and
 * the seams are the first thing the eye finds. See docs/layout.md.
 */
import PageChrome from "@/components/PageChrome.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <PageChrome />
    <slot />
  </body>
</html>
